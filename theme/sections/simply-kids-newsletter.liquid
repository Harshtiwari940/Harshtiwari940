{{ 'simply-kids.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #Newsletter--{{ section.id }} .sk-eyebrow {
    color: {{ section.settings.accent_color }};
  }

  #Newsletter--{{ section.id }} .sk-subscribe input[type='email'] {
    border-color: {{ section.settings.field_border }};
  }
{%- endstyle -%}

<div
  id="Newsletter--{{ section.id }}"
  class="sk-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="sk-container">
    <div class="sk-offer">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="sk-offer__title" style="font-size: {{ section.settings.heading_size }}rem;">
          {{- section.settings.heading -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="sk-offer__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.show_form -%}
        {%- assign subscribe_form_id = 'SkSubscribe--' | append: section.id -%}
        {%- render 'simply-kids-subscribe-form',
          form_id: subscribe_form_id,
          placeholder: section.settings.placeholder,
          button_label: section.settings.button_label,
          success_text: section.settings.success_text
        -%}
      {%- elsif section.settings.button_label != blank -%}
        <div class="sk-btn-row sk-btn-row--center" style="margin-top: 1.4rem;">
          <a href="{{ section.settings.button_link | default: '#' }}" class="sk-btn sk-btn--primary">
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="sk-offer__disclaimer">{{ section.settings.disclaimer | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK — Newsletter",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Simply Kids list"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 1.6,
      "max": 4.4,
      "step": 0.2,
      "unit": "rem",
      "label": "Heading size",
      "default": 2
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>Expert tips, new launches, and stories for growing kids. No spam — ever.</p>"
    },
    {
      "type": "header",
      "content": "Email capture"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show email signup form",
      "info": "Subscribers are saved to Shopify Customers with the newsletter tag.",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email field placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Only used when the signup form is turned off."
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thanks for subscribing."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Small print"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#004987"
    },
    {
      "type": "color",
      "id": "field_border",
      "label": "Email field border",
      "default": "#C3CED3"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "SK — Newsletter"
    }
  ]
}
{% endschema %}
