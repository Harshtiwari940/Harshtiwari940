{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    font-family: inherit;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }
  }

  /* ===== TOP GRADIENT LINE ===== */
  .sk-footer-topline {
    height: 4px;
    background: linear-gradient(90deg, #ff4d8d, #ffc93c, #1a5fb4);
    background-size: 200% 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sk-footer-topline { animation: sk-gradient-shift 6s ease infinite; }
  }
  @keyframes sk-gradient-shift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* ===== SCROLL-REVEAL ===== */
  @media (prefers-reduced-motion: no-preference) {
    .sk-reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(.21,.6,.35,1), transform 0.7s cubic-bezier(.21,.6,.35,1);
    }
    .sk-reveal.is-visible { opacity: 1; transform: translateY(0); }
    .sk-footer-main__inner > .sk-reveal:nth-child(1) { transition-delay: 0.05s; }
    .sk-footer-main__inner > .sk-reveal:nth-child(2) { transition-delay: 0.12s; }
    .sk-footer-main__inner > .sk-reveal:nth-child(3) { transition-delay: 0.19s; }
    .sk-footer-main__inner > .sk-reveal:nth-child(4) { transition-delay: 0.26s; }
  }

  /* ===== TOP FEATURE BOXES ===== */
  .sk-top-boxes {
    display: grid;
    grid-template-columns: 1fr 1fr 1.5fr;
    border: 1px solid #e5e5e5;
    border-bottom: none;
    margin-top: 20px;
    background: #fff;
  }
  .sk-top-box {
    text-align: center;
    padding: 28px 20px;
    border-right: 1px solid #e5e5e5;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .sk-top-box:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 24px rgba(20, 40, 70, 0.08);
    z-index: 1;
    position: relative;
  }
  .sk-top-box:last-child { border-right: none; }
  .sk-top-box img {
    width: 42px;
    height: 42px;
    object-fit: contain;
    margin-bottom: 12px;
    transition: transform 0.3s ease;
  }
  .sk-top-box:hover img { transform: scale(1.12) rotate(-4deg); }
  .sk-top-box h4 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: #222;
  }
  .sk-contact-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .sk-contact-box h3 {
    font-size: 26px;
    margin: 0 0 18px;
    color: #222;
    font-weight: 500;
  }
  .sk-contact-btn {
    display: inline-block;
    border: 2px solid #26a7df;
    color: #26a7df;
    text-decoration: none;
    padding: 12px 28px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 4px;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .sk-contact-btn:hover {
    background: #26a7df;
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 10px 18px rgba(38, 167, 223, 0.3);
  }

  /* ===== PAYMENT AREA ===== */
  .sk-payment-area {
    background: #fff;
    padding: 25px 30px;
    border: 1px solid #e5e5e5;
  }
  .sk-payment-area h4 {
    margin: 0 0 18px;
    font-size: 22px;
    color: #191970;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .sk-payment-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    color: #191970;
    font-size: 16px;
    font-weight: 500;
  }
  .sk-payment-note img { width: 22px; height: 22px; flex-shrink: 0; }
  .sk-payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .sk-payment-icons img {
    height: 34px !important;
    width: auto !important;
    max-width: 80px !important;
    object-fit: contain;
    padding: 6px 10px;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    background: #fff;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .sk-payment-icons img:hover {
    transform: translateY(-4px) scale(1.06);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    border-color: #c9d6e8;
  }
  .sk-payment-icons img[alt="UPI"] { max-width: 65px !important; }

  /* ===== MAIN FOOTER GRID ===== */
  .sk-footer-main {
    background: #f4f7fb;
    padding: 52px 0 40px;
  }
  .sk-footer-main__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }
  @media screen and (min-width: 750px) {
    .sk-footer-main__inner {
      grid-template-columns: 1fr 1fr 1fr 1.3fr;
      gap: 28px;
    }
  }

  /* ===== COLUMN STYLES ===== */
  .sk-footer-col__heading {
    position: relative;
    display: inline-block;
    font-size: 16px;
    font-weight: 700;
    color: #16325c;
    margin: 0 0 20px;
    letter-spacing: 0.01em;
    padding-bottom: 8px;
  }
  .sk-footer-col__heading::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 28px;
    height: 3px;
    border-radius: 2px;
    background: #ff4d8d;
    transform-origin: left;
    transition: width 0.35s ease;
  }
  .sk-footer-col:hover .sk-footer-col__heading::after { width: 100%; }

  .sk-footer-col__address {
    font-size: 13px;
    line-height: 1.75;
    color: #5b6b82;
    margin: 0 0 16px;
  }
  .sk-footer-col__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sk-footer-col__contact li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #33465e;
  }
  .sk-footer-col__contact a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .sk-footer-col__contact a:hover { color: #ff4d8d; }
  .sk-footer-col__contact svg { flex-shrink: 0; transition: transform 0.25s ease; }
  .sk-footer-col__contact li:hover svg { transform: scale(1.15) rotate(-6deg); color: #ff4d8d; }

  .sk-footer-col__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sk-footer-col__links a {
    position: relative;
    display: inline-block;
    font-size: 13px;
    color: #3d5570;
    text-decoration: none;
    transition: transform 0.25s ease, color 0.25s ease;
  }
  .sk-footer-col__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }
  .sk-footer-col__links a:hover {
    transform: translateX(4px);
    color: #ff4d8d;
  }
  .sk-footer-col__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* ===== BRAND COLUMN ===== */
  .sk-footer-brand__name {
    font-size: 19px;
    font-weight: 800;
    color: #16325c;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  /* ===== SOCIAL ICONS ===== */
  .sk-social-list {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .sk-social-list a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    color: #16325c;
    box-shadow: 0 2px 6px rgba(22, 50, 92, 0.12);
    transition: transform 0.3s ease, background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }
  .sk-social-list a:hover {
    transform: translateY(-4px) rotate(-8deg) scale(1.08);
    background: #ff4d8d;
    color: #fff;
    box-shadow: 0 10px 18px rgba(255, 77, 141, 0.32);
  }
  .sk-social-list svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* ===== NEWSLETTER ===== */
  .sk-newsletter {
    grid-column: 1 / -1;
    margin-top: 8px;
    padding-top: 32px;
    border-top: 1px solid #d9e2ef;
  }
  .sk-newsletter__heading {
    font-size: 16px;
    font-weight: 700;
    color: #16325c;
    margin: 0 0 16px;
  }
  .sk-newsletter__form {
    display: flex;
    max-width: 420px;
    background: #fff;
    border: 1px solid #c9d6e8;
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .sk-newsletter__form:focus-within {
    border-color: #ff4d8d;
    box-shadow: 0 0 0 3px rgba(255, 77, 141, 0.15);
  }
  .sk-newsletter__form input {
    flex: 1;
    border: none;
    padding: 14px 16px;
    font-size: 14px;
    outline: none;
    background: transparent;
    color: #16325c;
  }
  .sk-newsletter__form button {
    border: none;
    background: #ff4d8d;
    color: #fff;
    width: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.25s ease;
  }
  .sk-newsletter__form button svg { transition: transform 0.25s ease; }
  .sk-newsletter__form button:hover { background: #e83e7d; }
  .sk-newsletter__form button:hover svg { transform: translateX(4px); }
  .sk-newsletter__success {
    margin: 10px 0 0;
    font-size: 13px;
    color: #1a7a4c;
    font-weight: 600;
  }

  /* ===== BOTTOM BAR ===== */
  .sk-footer-bottom {
    background: #e8edf5;
    border-top: 1px solid #d0d9e8;
    padding: 16px 0;
  }
  .sk-footer-bottom__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .sk-footer-bottom__logos {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sk-footer-bottom__logos img {
    height: 34px;
    width: auto;
    object-fit: contain;
    transition: transform 0.25s ease;
  }
  .sk-footer-bottom__logos img:hover { transform: translateY(-3px); }
  .sk-footer-bottom__copy {
    font-size: 12.5px;
    color: #5b6b82;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .sk-footer-bottom__copy a { color: inherit; text-decoration: none; transition: color 0.2s ease; }
  .sk-footer-bottom__copy a:hover { color: #ff4d8d; text-decoration: underline; }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .sk-top-boxes {
      grid-template-columns: 1fr;
    }
    .sk-top-box {
      border-right: none;
      border-bottom: 1px solid #e5e5e5;
    }
    .sk-contact-box h3 { font-size: 20px; }
    .sk-payment-area { padding: 20px 15px; }
    .sk-payment-area h4 { font-size: 18px; }
    .sk-payment-note { font-size: 14px; align-items: flex-start; }
    .sk-payment-icons img { height: 30px !important; max-width: 70px !important; }
    .sk-footer-main__inner { padding: 0 16px; }
    .sk-newsletter__form { max-width: 100%; }
    .sk-footer-bottom__inner { padding: 0 16px; flex-direction: column; align-items: flex-start; }
  }
{%- endstyle -%}

