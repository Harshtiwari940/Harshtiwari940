{{ 'simply-kids.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #Science--{{ section.id }} .sk-eyebrow {
    color: {{ section.settings.accent_color }};
  }

  #Science--{{ section.id }} .sk-science-stats .sk-stat-value {
    color: {{ section.settings.accent_color }};
  }

  #Science--{{ section.id }} .sk-ingredient-chip {
    background: {{ section.settings.chip_background }};
    color: {{ section.settings.chip_text }};
  }
{%- endstyle -%}

{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign ingredient_blocks = section.blocks | where: 'type', 'ingredient'
-%}

<div
  id="Science--{{ section.id }}"
  class="sk-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="sk-container sk-container--narrow">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="sk-section__title" style="font-size: {{ section.settings.heading_size }}rem;">
        {{- section.settings.heading -}}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="sk-science__intro rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if ingredient_blocks.size > 0 -%}
      <div class="sk-science__chips">
        {%- for block in ingredient_blocks -%}
          <span class="sk-ingredient-chip" {{ block.shopify_attributes }}>
            {{- block.settings.name | escape -}}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if stat_blocks.size > 0 -%}
      <div class="sk-table-scroll">
        <table class="sk-science-stats">
          <caption class="sk-visually-hidden">{{ section.settings.table_caption | escape }}</caption>
          <thead>
            <tr>
              <th scope="col">{{ section.settings.column_1_label | escape }}</th>
              <th scope="col">{{ section.settings.column_2_label | escape }}</th>
              <th scope="col">{{ section.settings.column_3_label | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in stat_blocks -%}
              <tr {{ block.shopify_attributes }}>
                <td class="sk-stat-value">{{ block.settings.result | escape }}</td>
                <td>{{ block.settings.product | escape }}</td>
                <td>{{ block.settings.study | escape }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      {%- liquid
        assign science_link = section.settings.button_link
        if science_link == blank and section.settings.page != blank
          assign science_link = section.settings.page.url
        endif
      -%}
      <a href="{{ science_link | default: '#' }}" class="sk-btn sk-btn--primary">
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="sk-offer__disclaimer">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SK — Science",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why 4 to 12 matters"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The in-between years, finally taken seriously."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 1.6,
      "max": 4.4,
      "step": 0.2,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.2
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>By age four, a child's skin picks up its own oil profile. By twelve, that same skin is nearly adult. Most brands skip both moments and sell the years in between.</p>"
    },
    {
      "type": "header",
      "content": "Results table"
    },
    {
      "type": "text",
      "id": "table_caption",
      "label": "Table caption for screen readers",
      "default": "Study results by product"
    },
    {
      "type": "text",
      "id": "column_1_label",
      "label": "Column 1 heading",
      "default": "Result"
    },
    {
      "type": "text",
      "id": "column_2_label",
      "label": "Column 2 heading",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "column_3_label",
      "label": "Column 3 heading",
      "default": "Study"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the science"
    },
    {
      "type": "page",
      "id": "page",
      "label": "Page",
      "info": "The button links to this page unless a custom link is set below."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Custom button link"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#004987"
    },
    {
      "type": "color",
      "id": "chip_background",
      "label": "Ingredient chip background",
      "default": "#CFEDFD"
    },
    {
      "type": "color",
      "id": "chip_text",
      "label": "Ingredient chip text",
      "default": "#4A4744"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient chip",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient",
          "default": "Bhringraj"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Result row",
      "settings": [
        {
          "type": "text",
          "id": "result",
          "label": "Result",
          "default": "95% smoother hair"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product",
          "default": "Hair Oil"
        },
        {
          "type": "text",
          "id": "study",
          "label": "Study",
          "default": "4-week"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK — Science",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Bhringraj" } },
        { "type": "ingredient", "settings": { "name": "Jatamansi" } },
        { "type": "ingredient", "settings": { "name": "Haldi" } },
        {
          "type": "stat",
          "settings": { "result": "95% smoother hair", "product": "Hair Oil", "study": "4-week" }
        },
        {
          "type": "stat",
          "settings": { "result": "93% fewer rashes", "product": "Body Wash", "study": "from first wash" }
        }
      ]
    }
  ]
}
{% endschema %}
