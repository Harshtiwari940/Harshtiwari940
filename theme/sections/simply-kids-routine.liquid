{{ 'simply-kids.css' | asset_url | stylesheet_tag }}
<script src="{{ 'simply-kids-routine.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #Routine--{{ section.id }} .sk-quiz {
    background: {{ section.settings.panel_background }};
    color: {{ section.settings.panel_text }};
    border-radius: {{ section.settings.panel_radius }}px;
  }

  #Routine--{{ section.id }} .sk-quiz__title {
    color: {{ section.settings.panel_text }};
  }

  #Routine--{{ section.id }} .sk-quiz__opt {
    color: {{ section.settings.panel_text }};
  }

  #Routine--{{ section.id }} .sk-quiz__opt:hover,
  #Routine--{{ section.id }} .sk-quiz__opt[aria-selected='true'] {
    background: {{ section.settings.panel_text }};
    color: {{ section.settings.panel_background }};
  }
{%- endstyle -%}

<div
  id="Routine--{{ section.id }}"
  class="sk-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="sk-container">
    <sk-routine-picker class="sk-quiz">
      {%- if section.settings.heading != blank -%}
        <h2 class="sk-quiz__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="sk-quiz__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        {%- if section.settings.prompt != blank -%}
          <p class="sk-quiz__prompt" id="RoutinePrompt--{{ section.id }}">
            {{- section.settings.prompt | escape -}}
          </p>
        {%- endif -%}

        <div
          class="sk-quiz__options"
          role="tablist"
          {% if section.settings.prompt != blank %}
            aria-labelledby="RoutinePrompt--{{ section.id }}"
          {% endif %}
        >
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="sk-quiz__opt"
              role="tab"
              id="RoutineTab--{{ section.id }}-{{ forloop.index }}"
              aria-controls="RoutinePanel--{{ section.id }}-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-sk-routine-option
              {{ block.shopify_attributes }}
            >
              {{- block.settings.option_label | escape -}}
            </button>
          {%- endfor -%}
        </div>

        {%- for block in section.blocks -%}
          <div
            class="sk-quiz__result"
            role="tabpanel"
            id="RoutinePanel--{{ section.id }}-{{ forloop.index }}"
            aria-labelledby="RoutineTab--{{ section.id }}-{{ forloop.index }}"
            tabindex="0"
            data-sk-routine-panel
            {% unless forloop.first %}
              hidden
            {% endunless %}
          >
            {%- if block.settings.result_text != blank -%}
              <div class="rte">{{ block.settings.result_text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              {%- liquid
                assign block_link = block.settings.button_link
                if block_link == blank and block.settings.collection != blank
                  assign block_link = block.settings.collection.url
                endif
              -%}
              <a href="{{ block_link | default: '#' }}" class="sk-btn sk-btn--light">
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </sk-routine-picker>
  </div>
</div>

{% schema %}
{
  "name": "SK — Build a routine",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Let's build the perfect routine"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tap their age — we'll match the stage."
    },
    {
      "type": "text",
      "id": "prompt",
      "label": "Question",
      "default": "How old is your child?"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-6"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#004987"
    },
    {
      "type": "color",
      "id": "panel_text",
      "label": "Panel text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Panel corner radius",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "age_option",
      "name": "Age option",
      "settings": [
        {
          "type": "text",
          "id": "option_label",
          "label": "Option label",
          "default": "4–6"
        },
        {
          "type": "richtext",
          "id": "result_text",
          "label": "Result text",
          "default": "<p>Little Explorers: gentle, tear-free, and simple enough for them to start doing it themselves.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "See their routine"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "The button links to this collection unless a custom link is set below."
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Custom button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK — Build a routine",
      "blocks": [
        {
          "type": "age_option",
          "settings": {
            "option_label": "4–6",
            "result_text": "<p>Little Explorers: gentle, tear-free, and simple enough for them to start doing it themselves.</p>"
          }
        },
        {
          "type": "age_option",
          "settings": {
            "option_label": "7–9",
            "result_text": "<p>Big Kids: cleansing that keeps up with a full day outdoors, without stripping a still-developing barrier.</p>"
          }
        },
        {
          "type": "age_option",
          "settings": {
            "option_label": "10–12",
            "result_text": "<p>Tweens: grown-up textures and finishes, formulated without the harsh actives adult ranges rely on.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
