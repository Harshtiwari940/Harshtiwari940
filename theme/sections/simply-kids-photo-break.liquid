{{ 'simply-kids.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign alpha_center = section.settings.overlay_opacity_center | divided_by: 100.0
  assign alpha_mid = section.settings.overlay_opacity_mid | divided_by: 100.0
  assign alpha_edge = section.settings.overlay_opacity_edge | divided_by: 100.0
  assign overlay_center = section.settings.overlay_color | color_modify: 'alpha', alpha_center
  assign overlay_mid = section.settings.overlay_color | color_modify: 'alpha', alpha_mid
  assign overlay_edge = section.settings.overlay_color | color_modify: 'alpha', alpha_edge
-%}

{%- style -%}
  #PhotoBreak--{{ section.id }} {
    min-height: {{ section.settings.min_height_mobile }}vh;
  }

  #PhotoBreak--{{ section.id }} .sk-photo-break__overlay {
    background: radial-gradient(
      ellipse at center,
      {{ overlay_center }} 0%,
      {{ overlay_mid }} 55%,
      {{ overlay_edge }} 100%
    );
  }

  #PhotoBreak--{{ section.id }} .sk-photo-break__inner {
    color: {{ section.settings.text_color }};
  }

  #PhotoBreak--{{ section.id }} .sk-photo-break__title {
    color: {{ section.settings.text_color }};
  }

  #PhotoBreak--{{ section.id }} .sk-eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }

  @media screen and (min-width: 750px) {
    #PhotoBreak--{{ section.id }} {
      min-height: {{ section.settings.min_height }}vh;
    }
  }
{%- endstyle -%}

<div
  id="PhotoBreak--{{ section.id }}"
  class="sk-section sk-photo-break color-{{ section.settings.color_scheme }}"
>
  <div class="sk-photo-break__media">
    {%- render 'simply-kids-image',
      image: section.settings.image,
      fallback: 'sk-photo-break.jpg',
      alt: section.settings.image_alt,
      sizes: '100vw',
      widths: '550, 750, 1100, 1500, 2000, 3000',
      placeholder: 'lifestyle-1'
    -%}
  </div>

  <div class="sk-photo-break__overlay" aria-hidden="true"></div>

  <div class="sk-photo-break__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="sk-photo-break__title" style="font-size: {{ section.settings.heading_size }}rem;">
        {{- section.settings.heading -}}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="sk-photo-break__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="sk-btn-row sk-btn-row--center" style="margin-top: 2.4rem;">
        <a href="{{ section.settings.button_link | default: '#' }}" class="sk-btn sk-btn--light">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SK — Photo statement",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Falls back to the bundled lifestyle photo when empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Leave empty if the image is purely decorative."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why 4 to 12 matters"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Baby care's too mild. Adult care's too harsh."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 1.8,
      "max": 4.4,
      "step": 0.2,
      "unit": "rem",
      "label": "Heading size",
      "default": 3.4
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>We formulate for the nine years everyone else skips — tested on the children it's actually made for, not adults scaled down.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Minimum height on desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Minimum height on mobile",
      "default": 60
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow colour",
      "default": "#BEE7F5"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#001E3A"
    },
    {
      "type": "range",
      "id": "overlay_opacity_center",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Overlay opacity — centre",
      "default": 88
    },
    {
      "type": "range",
      "id": "overlay_opacity_mid",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Overlay opacity — middle",
      "default": 82
    },
    {
      "type": "range",
      "id": "overlay_opacity_edge",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Overlay opacity — edge",
      "default": 92
    }
  ],
  "presets": [
    {
      "name": "SK — Photo statement"
    }
  ]
}
{% endschema %}
