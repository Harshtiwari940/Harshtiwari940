{%- comment -%}
  Renders one of the Simply Kids line icons.

  Accepts:
  - icon: {String} One of 'cart', 'card', 'return', 'lock', 'leaf', 'drop', 'shield', 'none'.
  - size: {Number} Pixel size of the square icon. Default 40.
  - class: {String} Class attribute. Optional.

  The icons are decorative — every use sits next to a visible text label — so
  they are marked aria-hidden and hidden from the accessibility tree.
{%- endcomment -%}

{%- liquid
  assign icon_size = size | default: 40
-%}

{%- case icon -%}
  {%- when 'cart' -%}
    <svg class="{{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3 3h2l2.4 12.2a2 2 0 002 1.8h8.2a2 2 0 002-1.6L21 8H6"/>
      <circle cx="9" cy="20" r="1.4" fill="currentColor"/>
      <circle cx="17" cy="20" r="1.4" fill="currentColor"/>
    </svg>
  {%- when 'card' -%}
    <svg class="{{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="2" y="7" width="20" height="11" rx="1.5"/>
      <circle cx="12" cy="12.5" r="2.5"/>
      <path d="M2 10h2M20 10h2M2 15h2M20 15h2"/>
    </svg>
  {%- when 'return' -%}
    <svg class="{{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 12a8 8 0 0114-5.3M20 12a8 8 0 01-14 5.3"/>
      <path d="M18 3v4h-4M6 21v-4h4"/>
    </svg>
  {%- when 'lock' -%}
    <svg class="{{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="4" y="10" width="16" height="10" rx="2"/>
      <path d="M8 10V7a4 4 0 018 0v3"/>
    </svg>
  {%- when 'leaf' -%}
    <svg class="{{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M20 4c0 8-5 13-12 13H4c0-8 5-13 12-13z"/>
      <path d="M4 20c2-4 5-6.5 9-8"/>
    </svg>
  {%- when 'drop' -%}
    <svg class="{{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3s6 6.4 6 10.4A6 6 0 016 13.4C6 9.4 12 3 12 3z"/>
    </svg>
  {%- when 'shield' -%}
    <svg class="{{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3l7 3v5.5c0 4.3-2.9 8.2-7 9.5-4.1-1.3-7-5.2-7-9.5V6z"/>
      <path d="M9 12l2 2 4-4"/>
    </svg>
{%- endcase -%}
