{
  "sections": {
    "main": {
      "type": "main-article",
      "blocks": {
        "featured_image": {
          "type": "featured_image",
          "settings": { "image_height": "medium" }
        },
        "title": {
          "type": "title",
          "settings": { "blog_show_date": true, "blog_show_author": false }
        },
        "content": { "type": "content", "settings": {} },
        "share": { "type": "share", "settings": { "share_label": "Share" } }
      },
      "block_order": ["featured_image", "title", "content", "share"],
      "settings": {}
    },
    "journal": {
      "type": "sk-journal-strip",
      "settings": {
        "color_scheme": "scheme-8",
        "eyebrow": "Keep reading",
        "heading": "More from the Journal",
        "button_label": "View all articles",
        "post_limit": 3,
        "columns": "3",
        "padding_top": 72,
        "padding_bottom": 72
      }
    }
  },
  "order": ["main", "journal"]
}
