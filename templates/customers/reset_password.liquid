<div class="color-scheme-1" style="padding:5rem 0;">
  <div class="page-width" style="max-width:48rem;margin:0 auto;">
    <h1 class="sk-section__title" style="text-align:center;">{{ 'customer.reset_password.title' | t | default: 'Reset your password' }}</h1>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p class="sk-form-status sk-form-status--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <label class="sk-label" for="ResetPassword">{{ 'customer.reset_password.password' | t | default: 'New password' }}</label>
      <input class="sk-field" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>

      <label class="sk-label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t | default: 'Confirm password' }}</label>
      <input class="sk-field" id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>

      <button type="submit" class="sk-btn sk-btn--primary" style="width:100%;margin-top:1.6rem;border:0;cursor:pointer;">
        {{ 'customer.reset_password.submit' | t | default: 'Reset password' }}
      </button>
    {%- endform -%}
  </div>
</div>
