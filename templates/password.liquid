{% layout 'password' %}
<div class="color-scheme-3" style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:4rem 2rem;">
  <div style="max-width:48rem;width:100%;text-align:center;">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 600 | image_tag:
        loading: 'eager', widths: '150,300,450,600', alt: shop.name,
        style: 'width:180px;height:auto;margin:0 auto 2.4rem;display:block;' }}
    {%- else -%}
      <h1 style="font-size:2.8rem;">{{ shop.name }}</h1>
    {%- endif -%}

    <h2 style="font-size:2.2rem;">{{ 'general.password_page.opening_soon' | t | default: 'Opening soon' }}</h2>

    {%- if shop.password_message != blank -%}
      <div style="opacity:.85;">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'sk-password-signup' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p style="color:var(--sk-blue-deep);">{{ 'general.password_page.signup_form_success' | t | default: 'Thanks — we will let you know when we open.' }}</p>
      {%- endif -%}
      <label class="sk-label" for="PasswordEmail">{{ 'general.password_page.signup_form_email_label' | t | default: 'Email' }}</label>
      <input class="sk-field" id="PasswordEmail" type="email" name="contact[email]" placeholder="your@email.com" autocomplete="email" required>
      <button type="submit" class="sk-btn sk-btn--primary" style="margin-top:1.4rem;border:0;cursor:pointer;">
        {{ 'general.password_page.signup_form_button_label' | t | default: 'Notify me' }}
      </button>
    {%- endform -%}

    <div style="margin-top:3rem;">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p class="sk-form-status--error">{{ form.errors.messages['form'] }}</p>
        {%- endif -%}
        <label class="sk-label" for="StorefrontPassword">{{ 'general.password_page.login_form_password_label' | t | default: 'Enter store password' }}</label>
        <input class="sk-field" id="StorefrontPassword" type="password" name="password" autocomplete="current-password">
        <button type="submit" class="sk-btn sk-btn--outline" style="margin-top:1.4rem;border:0;cursor:pointer;">
          {{ 'general.password_page.login_form_submit' | t | default: 'Enter' }}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>
