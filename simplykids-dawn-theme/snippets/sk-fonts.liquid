{%- comment -%}
  Simply Kids — self-hosted brand faces.

  Nunito Sans (400/500/600/700/800) and Dancing Script (600/700) ship with the
  theme as .woff2 assets, so the brand typography is exact and does not depend
  on the Shopify font picker carrying these families. Dawn's own picked font
  remains the fallback in every stack (see simplykids-brand.css), so removing
  these assets degrades gracefully rather than breaking the theme.
{%- endcomment -%}

{% comment %}theme-check-disable AssetPreload{% endcomment %}
<link rel="preload" as="font" href="{{ 'sk-nunito-sans-400.woff2' | asset_url }}" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="{{ 'sk-nunito-sans-700.woff2' | asset_url }}" type="font/woff2" crossorigin>
{% comment %}theme-check-enable AssetPreload{% endcomment %}

{%- style -%}
  @font-face {
    font-family: 'Nunito Sans';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'sk-nunito-sans-400.woff2' | asset_url }}) format('woff2');
  }

  @font-face {
    font-family: 'Nunito Sans';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url({{ 'sk-nunito-sans-500.woff2' | asset_url }}) format('woff2');
  }

  @font-face {
    font-family: 'Nunito Sans';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url({{ 'sk-nunito-sans-600.woff2' | asset_url }}) format('woff2');
  }

  @font-face {
    font-family: 'Nunito Sans';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url({{ 'sk-nunito-sans-700.woff2' | asset_url }}) format('woff2');
  }

  @font-face {
    font-family: 'Nunito Sans';
    font-style: normal;
    font-weight: 800;
    font-display: swap;
    src: url({{ 'sk-nunito-sans-800.woff2' | asset_url }}) format('woff2');
  }

  @font-face {
    font-family: 'Dancing Script';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url({{ 'sk-dancing-script-600.woff2' | asset_url }}) format('woff2');
  }

  @font-face {
    font-family: 'Dancing Script';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url({{ 'sk-dancing-script-700.woff2' | asset_url }}) format('woff2');
  }
{%- endstyle -%}
