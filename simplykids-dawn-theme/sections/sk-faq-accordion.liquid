{%- comment -%}
  Simply Kids — FAQ accordion.
  Native <details>/<summary>, so it works without JavaScript. Optional
  FAQPage structured data is generated from the same blocks that render the
  visible copy, so the markup can never drift from what shoppers read.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .sk-faq {
    max-width: {{ section.settings.max_width }}rem;
    margin: 0 auto;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="sk-faq">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="sk-center" style="margin-bottom: 2rem;">
          {%- if section.settings.eyebrow != blank -%}
            <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            {%- if section.settings.heading_tag == 'h1' -%}
              <h1 class="sk-section__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h1>
            {%- else -%}
              <h2 class="sk-section__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        <details
          class="sk-faq__item"
          {% if block.settings.open %}open{% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="sk-faq__summary">{{ block.settings.question | escape }}</summary>
          <div class="sk-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.enable_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "SK FAQ accordion",
  "tag": "section",
  "class": "section sk-shopify-section",
  "max_blocks": 30,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1 (page title)" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 50,
      "max": 130,
      "step": 2,
      "unit": "rem",
      "label": "Maximum width",
      "default": 76
    },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Add FAQPage structured data",
      "info": "Enable on one FAQ section per page only.",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is this safe for sensitive skin?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes — every product is pH 5.5-balanced and dermatologically tested on children in the 4–12 range.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK FAQ accordion",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
