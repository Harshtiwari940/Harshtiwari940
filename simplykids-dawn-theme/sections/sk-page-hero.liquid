{%- comment -%}
  Simply Kids — Page hero.
  The shared interior-page header used by Shop, Journal, Contact, Affiliate,
  Science and the policy pages: optional breadcrumb, eyebrow, H1, intro copy,
  pills and up to two CTAs. Leaving the heading blank falls back to the page,
  collection, blog or article title, so it works on any template.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign heading = section.settings.heading
  unless section.settings.show_heading
    assign heading = ''
  endunless
  if heading == blank and section.settings.show_heading
    case template.name
      when 'page'
        assign heading = page.title
      when 'collection'
        assign heading = collection.title
      when 'blog'
        assign heading = blog.title
      when 'article'
        assign heading = article.title
      when 'search'
        assign heading = 'Search'
    endcase
  endif
  assign pills = section.settings.pills | split: ','
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding{% if section.settings.text_align == 'center' %} sk-center{% endif %}">
    <div class="{% if section.settings.narrow %}sk-measure{% endif %}">
      {%- if section.settings.breadcrumb != blank -%}
        <p class="sk-section__text" style="font-size: 1.2rem; opacity: 0.6; margin-bottom: 0.6rem;">
          {{- section.settings.breadcrumb | escape -}}
        </p>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if heading != blank -%}
        {%- if section.settings.heading_tag == 'h1' -%}
          <h1 class="sk-section__title {{ section.settings.heading_size }}">{{ heading | escape }}</h1>
        {%- else -%}
          <h2 class="sk-section__title {{ section.settings.heading_size }}">{{ heading | escape }}</h2>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="sk-section__text" style="font-size: 1.6rem; opacity: 0.85;">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.pills != blank -%}
        <div style="display: flex; gap: 1.2rem; flex-wrap: wrap; margin: 2rem 0;{% if section.settings.text_align == 'center' %} justify-content: center;{% endif %}">
          {%- for pill in pills -%}
            <span class="sk-pill sk-pill--age">{{ pill | strip | escape }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div style="display: flex; gap: 1.4rem; flex-wrap: wrap; margin-top: 1.4rem;{% if section.settings.text_align == 'center' %} justify-content: center;{% endif %}">
          {%- if section.settings.button_label != blank -%}
            <a
              class="sk-btn sk-btn--primary"
              {% if section.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link }}"
              {% endif %}
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              class="sk-btn sk-btn--outline"
              {% if section.settings.button_link_2 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link_2 }}"
              {% endif %}
            >
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Page hero",
  "tag": "section",
  "class": "section sk-shopify-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "Constrain text width",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb",
      "label": "Breadcrumb line"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show the heading",
      "info": "Turn off when the section below already renders the page heading, for example Dawn's blog section.",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page, collection, blog or article title."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1 (page title)" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "pills",
      "label": "Pills",
      "info": "Comma separated."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "SK Page hero"
    }
  ]
}
{% endschema %}
