{%- comment -%}
  Simply Kids — Founders / generations list.
  Numbered (or photographed) rows for the people behind the brand.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .sk-founders {
    max-width: {{ section.settings.max_width }}rem;
    margin: 0 auto;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="sk-founders">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="sk-center" style="margin-bottom: 3rem;">
          {%- if section.settings.eyebrow != blank -%}
            <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="sk-section__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        <div class="sk-story-gen" {{ block.shopify_attributes }}>
          <div class="sk-story-gen__badge">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 200
                | image_tag: loading: 'lazy', widths: '100, 150, 200', alt: block.settings.name
              }}
            {%- else -%}
              {{ forloop.index }}
            {%- endif -%}
          </div>
          <div>
            {%- if block.settings.name != blank -%}
              <h3 class="sk-story-gen__name">{{ block.settings.name | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.role != blank -%}
              <span class="sk-story-gen__role">{{ block.settings.role | escape }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div>{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Founders",
  "tag": "section",
  "class": "section sk-shopify-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Meet Our Founders"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 50,
      "max": 130,
      "step": 2,
      "unit": "rem",
      "label": "Maximum width",
      "default": 80
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Optional — a number is shown when empty."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Pratibha Gupta"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "M.Sc. Botanical Sciences, Medical Plants Expert — “The Brain”"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Bio",
          "default": "<p>A visionary in medicinal plants and sustainability, she brings over 20 years of expertise to every formulation.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Founders",
      "blocks": [
        { "type": "person" },
        { "type": "person" },
        { "type": "person" }
      ]
    }
  ]
}
{% endschema %}
