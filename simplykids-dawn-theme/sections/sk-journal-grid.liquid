{%- comment -%}
  Simply Kids — Journal grid.
  Pulls real articles from a Shopify blog, so posts are published and edited in
  Shopify Admin rather than hard-coded. Falls back to editable placeholder
  cards (matching the affiliate design) when the blog has no articles yet.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .sk-grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sk-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

{%- liquid
  comment
    Named sk_* so the section never shadows Shopify's global `blog` object
    when it is placed on a blog template, and so `limit` stays free as a
    for-loop keyword.
  endcomment
  assign sk_blog = blogs[section.settings.blog]
  assign sk_articles = sk_blog.articles
  assign sk_limit = section.settings.post_limit
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.button_label != blank -%}
      <div class="sk-journal-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="sk-section__title {{ section.settings.heading_size }}" style="margin: 0;">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a
            class="sk-btn sk-btn--outline"
            href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}{{ sk_blog.url }}{% endif %}"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <div class="sk-section__text" style="margin-bottom: 3rem;">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="sk-grid sk-grid--3">
      {%- if sk_articles.size > 0 -%}
        {%- for article in sk_articles limit: sk_limit -%}
          <div
            class="sk-card sk-card--flush{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- liquid
              assign sk_article_alt = article.image.alt
              if sk_article_alt == blank
                assign sk_article_alt = article.title
              endif
            -%}
            <a class="sk-journal-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}
                {{
                  article.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    alt: sk_article_alt
                }}
              {%- else -%}
                <span class="sk-journal-card__placeholder">{{ section.settings.placeholder_label | escape }}</span>
              {%- endif -%}
            </a>
            <div class="sk-journal-card__body">
              <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              {%- if section.settings.show_excerpt -%}
                <p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
              {%- endif -%}
              {%- if section.settings.show_date -%}
                <p>{{ article.published_at | time_tag: format: 'date' }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign sk_post_alt = block.settings.image.alt
            if sk_post_alt == blank
              assign sk_post_alt = block.settings.title
            endif
          -%}
          <div class="sk-card sk-card--flush" {{ block.shopify_attributes }}>
            <div class="sk-journal-card__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    alt: sk_post_alt
                }}
              {%- else -%}
                <span class="sk-journal-card__placeholder">{{ section.settings.placeholder_label | escape }}</span>
              {%- endif -%}
            </div>
            <div class="sk-journal-card__body">
              <h3>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                {%- else -%}
                  {{ block.settings.title | escape }}
                {%- endif -%}
              </h3>
              {%- if block.settings.excerpt != blank -%}
                <p>{{ block.settings.excerpt | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Journal grid",
  "tag": "section",
  "class": "section sk-shopify-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From the Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real answers for the 4–12 years."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Articles to show",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": false
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Image placeholder label",
      "default": "Article photo"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all articles"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to the selected blog."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "placeholder_post",
      "name": "Placeholder article",
      "settings": [
        {
          "type": "paragraph",
          "content": "Shown only until the selected blog has published articles."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Why 4–12 is a real, distinct life stage for skin and hair"
        },
        {
          "type": "text",
          "id": "excerpt",
          "label": "Excerpt",
          "default": "The science behind why this age group needs its own formulas."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Journal grid",
      "blocks": [
        { "type": "placeholder_post" },
        { "type": "placeholder_post" },
        { "type": "placeholder_post" }
      ]
    }
  ]
}
{% endschema %}
