{%- comment -%}
  Simply Kids — "Share your little one's magic" submission form.
  Uses Shopify's native contact form, so entries arrive in the store's
  customer-service inbox with no third-party service. Artwork itself is
  requested by email reply, because Shopify's contact form cannot accept file
  uploads (see docs/INTEGRATION-NOTES.md).
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="sk-form">
      {%- if section.settings.heading != blank -%}
        <h2 class="sk-section__title h2 sk-center">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="sk-section__text sk-center">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- assign sk_submit_id = 'SkCommunitySubmit-' | append: section.id -%}
      {%- form 'contact', id: sk_submit_id -%}
        {%- if form.posted_successfully? -%}
          <p class="sk-form-message sk-form-message--success" tabindex="-1" autofocus>
            {{- section.settings.success_text | escape -}}
          </p>
        {%- elsif form.errors -%}
          <div class="sk-form-message sk-form-message--error" role="alert" tabindex="-1" autofocus>
            {{ 'templates.contact.form.error_heading' | t }}
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[subject]" value="{{ section.settings.email_subject | escape }}">

        <label for="SkChildName-{{ section.id }}">{{ section.settings.label_child_name | escape }}</label>
        <input
          id="SkChildName-{{ section.id }}"
          type="text"
          name="contact[Child first name]"
          required
        >

        <label for="SkChildAge-{{ section.id }}">{{ section.settings.label_child_age | escape }}</label>
        <select id="SkChildAge-{{ section.id }}" name="contact[Child age]" required>
          <option value="">{{ section.settings.age_placeholder | escape }}</option>
          {%- for age in (4..12) -%}
            <option value="{{ age }}">{{ age }}</option>
          {%- endfor -%}
        </select>

        <label for="SkParentEmail-{{ section.id }}">{{ section.settings.label_email | escape }}</label>
        <input
          id="SkParentEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          autocomplete="email"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          required
        >

        <label for="SkSubmitMessage-{{ section.id }}">{{ section.settings.label_message | escape }}</label>
        <textarea id="SkSubmitMessage-{{ section.id }}" name="contact[body]" rows="4"></textarea>

        <button type="submit" class="sk-btn sk-btn--hero sk-btn--full">
          {{- section.settings.button_label | escape -}}
        </button>

        {%- if section.settings.guidelines != blank -%}
          <div class="sk-form__note">{{ section.settings.guidelines }}</div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Community submission",
  "tag": "section",
  "class": "section sk-shopify-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Share your little one's magic"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "email_subject",
      "label": "Email subject",
      "default": "Be The Pride — community entry"
    },
    {
      "type": "text",
      "id": "label_child_name",
      "label": "Child name label",
      "default": "Child's first name"
    },
    {
      "type": "text",
      "id": "label_child_age",
      "label": "Child age label",
      "default": "Child's age"
    },
    {
      "type": "text",
      "id": "age_placeholder",
      "label": "Age placeholder",
      "default": "Select age"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email label",
      "default": "Parent/guardian email"
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Message label",
      "default": "Tell us about the artwork"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Submit entry"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thank you — we'll be in touch about your entry."
    },
    {
      "type": "richtext",
      "id": "guidelines",
      "label": "Guidelines",
      "default": "<p>By submitting you confirm you are the parent or guardian and consent to us featuring the artwork. Reply to our confirmation email with the artwork photo attached.</p>"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "SK Community submission"
    }
  ]
}
{% endschema %}
