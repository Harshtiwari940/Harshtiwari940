{%- comment -%}
  Simply Kids — Science / stats.

  Eyebrow, heading and intro, then any number of blocks in the order the
  merchant arranges them: prose, a row of ingredient chips with hover/tap
  tooltips, or an efficacy results table. Each block renders one complete,
  self-contained element, so blocks can be reordered freely without ever
  producing unbalanced markup.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .sk-science {
    max-width: {{ section.settings.max_width }}rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="sk-science">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        {%- if section.settings.heading_tag == 'h1' -%}
          <h1 class="sk-section__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h1>
        {%- else -%}
          <h2 class="sk-section__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <div class="sk-section__text sk-measure">{{ section.settings.intro }}</div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="sk-section__title">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="sk-section__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

          {%- when 'chips' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="sk-section__title">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              <sk-tooltip-chips style="display: block; margin-bottom: 1.6rem;">
                {%- assign chip_lines = block.settings.chips | newline_to_br | split: '<br />' -%}
                {%- for line in chip_lines -%}
                  {%- assign parts = line | strip_newlines | strip | split: '|' -%}
                  {%- assign chip_label = parts[0] | strip -%}
                  {%- if chip_label != blank -%}
                    {%- assign chip_tip = parts[1] | strip -%}
                    <span
                      class="sk-ingredient-chip"
                      {% if chip_tip != blank %}
                        data-tip="{{ chip_tip | escape }}"
                        title="{{ chip_tip | escape }}"
                      {% endif %}
                    >
                      {{- chip_label | escape -}}
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </sk-tooltip-chips>
            </div>

          {%- when 'stats' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="sk-section__title">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              <div class="sk-table-scroll">
                <table class="sk-science-stats">
                  <thead>
                    <tr>
                      <th scope="col">{{ block.settings.col_1 | escape }}</th>
                      <th scope="col">{{ block.settings.col_2 | escape }}</th>
                      <th scope="col">{{ block.settings.col_3 | escape }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {%- assign stat_lines = block.settings.rows | newline_to_br | split: '<br />' -%}
                    {%- for line in stat_lines -%}
                      {%- assign parts = line | strip_newlines | strip | split: '|' -%}
                      {%- assign stat_result = parts[0] | strip -%}
                      {%- if stat_result != blank -%}
                        <tr>
                          <td class="sk-stat-value">{{ stat_result | escape }}</td>
                          <td>{{ parts[1] | strip | escape }}</td>
                          <td>{{ parts[2] | strip | escape }}</td>
                        </tr>
                      {%- endif -%}
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
              {%- if block.settings.disclaimer != blank -%}
                <p style="font-size: 1.2rem; opacity: 0.6;">{{ block.settings.disclaimer | escape }}</p>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="sk-btn sk-btn--primary"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Science stats",
  "tag": "section",
  "class": "section sk-shopify-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-7"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why 4 to 12 matters"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The in-between years, finally taken seriously."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 only on a page where this section is the main heading.",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h1", "label": "H1" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>By age four, a child's skin picks up its own oil profile. By twelve, that same skin is nearly adult. Most brands skip both moments and sell the years in between.</p>"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 60,
      "max": 130,
      "step": 2,
      "unit": "rem",
      "label": "Content maximum width",
      "default": 76
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the science"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "chips",
      "name": "Ingredient chips",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "chips",
          "label": "Ingredients",
          "info": "One per line, in the form: Ingredient | tooltip. The tooltip is optional.",
          "default": "Bhringraj | Strengthens the hair shaft from root to tip.\nJatamansi | Soothes an irritated scalp.\nHaldi | Calms and clarifies skin."
        }
      ]
    },
    {
      "type": "stats",
      "name": "Results table",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "col_1",
          "label": "Column 1 heading",
          "default": "Result"
        },
        {
          "type": "text",
          "id": "col_2",
          "label": "Column 2 heading",
          "default": "Product"
        },
        {
          "type": "text",
          "id": "col_3",
          "label": "Column 3 heading",
          "default": "Study"
        },
        {
          "type": "textarea",
          "id": "rows",
          "label": "Rows",
          "info": "One per line, in the form: Result | Product | Study.",
          "default": "95% smoother hair | Hair Oil | 4-week\n93% fewer rashes | Body Wash | from first wash"
        },
        {
          "type": "text",
          "id": "disclaimer",
          "label": "Disclaimer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Science stats",
      "blocks": [
        { "type": "chips" },
        { "type": "stats" }
      ]
    }
  ]
}
{% endschema %}
