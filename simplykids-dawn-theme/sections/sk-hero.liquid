{%- comment -%}
  Simply Kids — Hero (age spectrum).
  Reproduces the affiliate homepage hero: eyebrow, split headline with a
  Dancing Script accent, two CTAs, the 4–12 age spectrum bar, a footnote and a
  review line, beside a media panel with a floating stat badge.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="sk-hero section-{{ section.id }}-padding">
    <div class="sk-hero__grid">
      <div class="sk-hero__copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {%- comment -%}
            The heading is a richtext setting so the merchant can italicise a
            word for the Dancing Script accent. Richtext wraps its content in
            <p>, which is not valid inside an <h1>, so the paragraphs are
            unwrapped and any paragraph break becomes a line break.
          {%- endcomment -%}
          {%- liquid
            assign sk_hero_heading = section.settings.heading | replace: '</p><p>', '<br>' | replace: '</p>', '' | replace: '<p>', ''
          -%}
          <h1 class="sk-hero__title">{{ sk_hero_heading }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="sk-hero__sub">{{ section.settings.subheading }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
          <div class="sk-hero__actions">
            {%- if section.settings.button_label != blank -%}
              <a
                class="sk-btn sk-btn--hero"
                {% if section.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link }}"
                {% endif %}
              >
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a
                class="sk-btn sk-btn--outline"
                {% if section.settings.button_link_2 == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link_2 }}"
                {% endif %}
              >
                {{- section.settings.button_label_2 | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_spectrum -%}
          <div class="sk-hero__spectrum" role="img" aria-label="{{ section.settings.spectrum_a11y | escape }}">
            <span aria-hidden="true">{{ section.settings.spectrum_min | escape }}</span>
            <div class="sk-hero__spectrum-track" aria-hidden="true">
              <span class="sk-hero__spectrum-dot" style="left: 0%"></span>
              <span class="sk-hero__spectrum-dot" style="left: 50%"></span>
              <span class="sk-hero__spectrum-dot" style="left: 100%"></span>
            </div>
            <span aria-hidden="true">{{ section.settings.spectrum_max | escape }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.footnote != blank -%}
          <p class="sk-hero__footnote">{{ section.settings.footnote | escape }}</p>
        {%- endif -%}

        {%- if section.settings.rating_text != blank -%}
          <div class="sk-hero__rating">
            <span class="sk-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span>{{ section.settings.rating_text | escape }}</span>
          </div>
        {%- endif -%}
      </div>

      {%- liquid
        assign sk_hero_alt = section.settings.image.alt
        if sk_hero_alt == blank
          assign sk_hero_alt = section.settings.heading | strip_html
        endif
      -%}
      <div class="sk-hero__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 45vw, 100vw',
              alt: sk_hero_alt
          }}
        {%- else -%}
          <img
            src="{{ 'sk-hero-shampoo.jpg' | asset_url }}"
            alt="{{ sk_hero_alt | escape }}"
            width="1200"
            height="1500"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}

        {%- if section.settings.stat_badge != blank -%}
          <div class="sk-hero__stat-badge">{{ section.settings.stat_badge | escape }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Hero",
  "tag": "section",
  "class": "section sk-shopify-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Only for the ages 4–12"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap a word in italics to render it in the Dancing Script brand accent.",
      "default": "<p>Growing-up care, made <em>kid-safe</em>.</p>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Dermatologically tested, pH 5.5-balanced formulas for the in-between years — proven gentle enough to trust, effective enough to work.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Find their stage"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Falls back to the packaged Simply Kids hero photo when empty."
    },
    {
      "type": "text",
      "id": "stat_badge",
      "label": "Floating stat badge",
      "default": "95% smoother hair*"
    },
    {
      "type": "header",
      "content": "Age spectrum"
    },
    {
      "type": "checkbox",
      "id": "show_spectrum",
      "label": "Show the age spectrum bar",
      "default": true
    },
    {
      "type": "text",
      "id": "spectrum_min",
      "label": "Youngest age",
      "default": "4"
    },
    {
      "type": "text",
      "id": "spectrum_max",
      "label": "Oldest age",
      "default": "12"
    },
    {
      "type": "text",
      "id": "spectrum_a11y",
      "label": "Spectrum description for screen readers",
      "default": "Formulated for ages 4 to 12"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Baby care's too mild. Adult care's too harsh. We built for the nine years in between."
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating line",
      "default": "4.8 · 112 verified parent reviews"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "SK Hero"
    }
  ]
}
{% endschema %}
