{%- comment -%}
  Simply Kids — Brand footer (optional).

  Reproduces the midnight-blue, rounded-top footer from the Simply Kids design:
  logo + blurb, up to four menu columns, a care column and a bottom bar.

  It is an ALTERNATIVE to the store's existing custom footer, not a
  replacement — the theme ships with the original footer active and this one
  hidden, so the merchant can switch by toggling section visibility in
  Theme Editor > Footer.

  Every column is driven by a Shopify navigation menu (Online Store >
  Navigation), never hard-coded links, and the social links come from
  Theme settings > Social media.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .sk-brand-footer {
    border-radius: {{ section.settings.corner_radius }}px {{ section.settings.corner_radius }}px 0 0;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 2rem {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sk-brand-footer {
      margin-top: {{ section.settings.margin_top }}px;
      padding: {{ section.settings.padding_top }}px 3rem {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .sk-brand-footer__grid {
    display: grid;
    grid-template-columns: 1.3fr repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
    gap: 2rem;
    max-width: var(--page-width, 124rem);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer__logo img {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    margin-bottom: 1rem;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer h2 {
    font-family: var(--sk-font-label);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 1rem;
    font-weight: 800;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer li a,
  #shopify-section-{{ section.id }} .sk-brand-footer__care p {
    display: block;
    opacity: 0.85;
    font-size: 1.4rem;
    margin: 0 0 0.7rem;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer li a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer__blurb {
    font-size: 1.4rem;
    max-width: 32rem;
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer__social {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer__social a {
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer__social svg {
    width: 20px;
    height: 20px;
    fill: currentcolor;
  }

  #shopify-section-{{ section.id }} .sk-brand-footer__bottom {
    max-width: var(--page-width, 124rem);
    margin: 3rem auto 0;
    padding-top: 1.6rem;
    border-top: 1px solid rgb(255 255 255 / 20%);
    display: flex;
    justify-content: space-between;
    font-size: 1.2rem;
    opacity: 0.75;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sk-brand-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .sk-brand-footer__grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<footer class="sk-brand-footer color-{{ section.settings.color_scheme }} gradient" role="contentinfo">
  <div class="sk-brand-footer__grid">
    <div class="sk-brand-footer__brand">
      <div class="sk-brand-footer__logo">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 400
            | image_tag: loading: 'lazy', widths: '100, 200, 300, 400', alt: shop.name
          }}
        {%- else -%}
          <img src="{{ 'sk-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="560" height="238" loading="lazy">
        {%- endif -%}
      </div>
      {%- if section.settings.blurb != blank -%}
        <div class="sk-brand-footer__blurb">{{ section.settings.blurb }}</div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="sk-brand-footer__col" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2>{{ block.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- if block.settings.menu != blank -%}
              <ul role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'policies' -%}
            <ul role="list">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'care' -%}
            <div class="sk-brand-footer__care">
              {%- if block.settings.phone != blank -%}
                <p><a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone | escape }}</a></p>
              {%- endif -%}
              {%- if block.settings.email != blank -%}
                <p><a href="mailto:{{ block.settings.email }}">{{ block.settings.email | escape }}</a></p>
              {%- endif -%}
              {%- if block.settings.address != blank -%}
                <p>{{ block.settings.address | escape }}</p>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                <div class="sk-brand-footer__social">
                  {%- if settings.social_instagram_link != blank -%}
                    <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
                      {{- 'icon-instagram.svg' | inline_asset_content -}}
                    </a>
                  {%- endif -%}
                  {%- if settings.social_pinterest_link != blank -%}
                    <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" aria-label="Pinterest">
                      {{- 'icon-pinterest.svg' | inline_asset_content -}}
                    </a>
                  {%- endif -%}
                  {%- if settings.social_youtube_link != blank -%}
                    <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube">
                      {{- 'icon-youtube.svg' | inline_asset_content -}}
                    </a>
                  {%- endif -%}
                  {%- if settings.social_facebook_link != blank -%}
                    <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
                      {{- 'icon-facebook.svg' | inline_asset_content -}}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="sk-brand-footer__bottom">
    <span>
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
      {%- if section.settings.legal_entity != blank %} &middot; {{ section.settings.legal_entity | escape }}{% endif -%}
    </span>
    {%- if section.settings.bottom_note != blank -%}
      <span>{{ section.settings.bottom_note | escape }}</span>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "SK Brand footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "paragraph",
      "content": "An alternative, Simply Kids-branded footer. Hide the store's existing Footer section before showing this one so only one footer renders."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-10"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo",
      "info": "Falls back to the packaged Simply Kids logo when empty."
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo height",
      "default": 32
    },
    {
      "type": "richtext",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "<p>Proven, gentle self-care made only for growing kids, ages 4–12. Nani's love, clinically kept.</p>"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Top corner radius",
      "default": 24
    },
    {
      "type": "text",
      "id": "legal_entity",
      "label": "Legal entity",
      "default": "a division of Omakase Enterprises LLP"
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Bottom note",
      "default": "Free shipping over ₹999 · Ships across India"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Create menus in Online Store > Navigation."
        }
      ]
    },
    {
      "type": "policies",
      "name": "Policies column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Policies"
        },
        {
          "type": "paragraph",
          "content": "Lists the store policies published in Settings > Policies."
        }
      ]
    },
    {
      "type": "care",
      "name": "Care column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Care"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+91-6297450751"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "support@simplykids.in"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address",
          "default": "Primarc Chambers, Unit OU-114, 1839 Laskarhat, Tagore Park, E. M. Bypass, Kolkata – 700039"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social links",
          "info": "Uses the links in Theme settings > Social media.",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Brand footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Our Story" } },
        { "type": "policies" },
        { "type": "care" }
      ]
    }
  ]
}
{% endschema %}
