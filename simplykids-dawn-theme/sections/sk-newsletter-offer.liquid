{%- comment -%}
  Simply Kids — Newsletter / offer band.
  Uses Shopify's own customer form, so subscribers land in Shopify Admin >
  Customers tagged "newsletter" exactly as Dawn's newsletter section does.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding sk-offer">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="sk-offer__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="sk-offer__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- assign sk_newsletter_id = 'SKNewsletter-' | append: section.id -%}
    {%- form 'customer', id: sk_newsletter_id, class: 'sk-offer__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="sk-subscribe-row">
        <label class="visually-hidden" for="SKNewsletterEmail-{{ section.id }}">
          {{- 'newsletter.label' | t -}}
        </label>
        <input
          id="SKNewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="SKNewsletterError-{{ section.id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="SKNewsletterSuccess-{{ section.id }}"
          {% endif %}
          placeholder="{{ section.settings.placeholder | escape }}"
          required
        >
        <button type="submit" class="sk-btn sk-btn--primary" name="commit">
          {{- section.settings.button_label | escape -}}
        </button>
      </div>

      {%- if form.errors -%}
        <small class="sk-offer__error" id="SKNewsletterError-{{ section.id }}" role="alert">
          {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
        </small>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <p class="sk-offer__success" id="SKNewsletterSuccess-{{ section.id }}" tabindex="-1" autofocus>
          {{- section.settings.success_text | default: 'Thanks for subscribing.' | escape -}}
        </p>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.footnote != blank -%}
      <p style="font-size: 1.2rem; opacity: 0.7; margin-top: 1.2rem;">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SK Newsletter offer",
  "tag": "section",
  "class": "section sk-shopify-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-12"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "10% off your first order"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Expert tips, new launches, and stories for growing kids. No spam — ever."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thanks — your discount is on its way to your inbox."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "SK Newsletter offer"
    }
  ]
}
{% endschema %}
