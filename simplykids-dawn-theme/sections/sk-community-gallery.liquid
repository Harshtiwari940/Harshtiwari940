{%- comment -%}
  Simply Kids — Community gallery.
  Square cards for each young creator: name, age and an optional artwork
  image. Cards without an image use a brand colour scheme, exactly as in the
  affiliate design.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sk-gallery-grid {
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="page-width sk-center" style="margin-bottom: 2rem;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="sk-section__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="sk-gallery-grid">
      {%- for block in section.blocks -%}
        <div
          class="sk-gallery-card color-{{ block.settings.card_scheme }} gradient{% if block.settings.image != blank %} sk-gallery-card--has-image{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- liquid
            assign sk_creator_alt = block.settings.image.alt
            if sk_creator_alt == blank
              assign sk_creator_alt = block.settings.name
            endif
          -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag:
                class: 'sk-gallery-card__image',
                loading: 'lazy',
                widths: '300, 500, 800',
                sizes: '(min-width: 990px) 25vw, 50vw',
                alt: sk_creator_alt
            }}
          {%- endif -%}
          {%- if block.settings.name != blank -%}
            <div class="sk-gallery-card__name">{{ block.settings.name | escape }}</div>
          {%- endif -%}
          {%- if block.settings.age != blank -%}
            <div class="sk-gallery-card__age">{{ block.settings.age | escape }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Community gallery",
  "tag": "section",
  "class": "section sk-shopify-section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet our young creators"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "creator",
      "name": "Creator",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Artwork"
        },
        {
          "type": "text",
          "id": "name",
          "label": "First name",
          "default": "Anagha"
        },
        {
          "type": "text",
          "id": "age",
          "label": "Age",
          "default": "Age 8"
        },
        {
          "type": "color_scheme",
          "id": "card_scheme",
          "label": "Card color scheme",
          "default": "scheme-4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Community gallery",
      "blocks": [
        { "type": "creator", "settings": { "name": "Anagha", "age": "Age 8", "card_scheme": "scheme-4" } },
        { "type": "creator", "settings": { "name": "Shaurya", "age": "Age 6", "card_scheme": "scheme-9" } },
        { "type": "creator", "settings": { "name": "Abhimanyu", "age": "Age 10", "card_scheme": "scheme-8" } },
        { "type": "creator", "settings": { "name": "Saranya", "age": "Age 10", "card_scheme": "scheme-3" } }
      ]
    }
  ]
}
{% endschema %}
