{%- comment -%}
  Simply Kids — Ritual lines.
  Alternating image / copy rows describing each ritual in the routine system.
  Every row is a block: image, label, title, body and ingredient chips.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="sk-center" style="max-width: 70rem; margin: 0 auto 5rem; padding: 0 3rem;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sk-section__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- liquid
        assign reversed = ''
        assign remainder = forloop.index0 | modulo: 2
        if remainder == 1
          assign reversed = ' sk-ritual-grid--rev'
        endif
        if block.settings.layout == 'image_left'
          assign reversed = ''
        elsif block.settings.layout == 'image_right'
          assign reversed = ' sk-ritual-grid--rev'
        endif

        assign sk_ritual_alt = block.settings.image.alt
        if sk_ritual_alt == blank
          assign sk_ritual_alt = block.settings.title
        endif
      -%}
      <div
        class="sk-ritual-grid{{ reversed }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="sk-ritual__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 990px) 45vw, 100vw',
                alt: sk_ritual_alt
            }}
          {%- elsif block.settings.fallback_image != 'none' -%}
            <img
              src="{{ block.settings.fallback_image | asset_url }}"
              alt="{{ block.settings.title | escape }}"
              width="1200"
              height="900"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="sk-ritual__copy">
          {%- if block.settings.label != blank -%}
            <div class="sk-ritual__label">{{ block.settings.label | escape }}</div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="sk-ritual__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="sk-ritual__text">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.chips != blank -%}
            <div class="sk-ritual__chips">
              {%- assign chips = block.settings.chips | split: ',' -%}
              {%- for chip in chips -%}
                <span class="sk-chip-outline">{{ chip | strip | escape }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a
              class="sk-btn sk-btn--primary"
              style="margin-top: 2rem;"
              {% if block.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_link }}"
              {% endif %}
            >
              {{- block.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SK Ritual lines",
  "tag": "section",
  "class": "section sk-shopify-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Simply Kids ritual system"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three rituals. Nine years. One routine that actually fits."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "ritual",
      "name": "Ritual",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Packaged image (used when no image is chosen)",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "sk-ritual-1-wash-day.jpg", "label": "Ritual 01 — wash day" },
            { "value": "sk-ritual-2-all-day.jpg", "label": "Ritual 02 — all-day shield" },
            { "value": "sk-ritual-3-bedtime.jpg", "label": "Ritual 03 — bedtime" },
            { "value": "sk-photo-break.jpg", "label": "Lifestyle photo" },
            { "value": "sk-product-shampoo.jpg", "label": "Product — 2-in-1 Shampoo + Conditioner" },
            { "value": "sk-product-hair-oil.jpg", "label": "Product — Nourishing Hair Oil" },
            { "value": "sk-product-body-wash.jpg", "label": "Product — Gentle Body Wash" },
            { "value": "sk-product-body-lotion.jpg", "label": "Product — Deep Hydration Body Lotion" },
            { "value": "sk-product-massage-oil.jpg", "label": "Product — Nourishing Body Massage Oil" },
            { "value": "sk-hero-shampoo.jpg", "label": "Hero photo" }
          ],
          "default": "sk-ritual-1-wash-day.jpg"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Image position",
          "options": [
            { "value": "auto", "label": "Alternate automatically" },
            { "value": "image_left", "label": "Image left" },
            { "value": "image_right", "label": "Image right" }
          ],
          "default": "auto"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Ritual label",
          "default": "Ritual 01 — the wash-day fix"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "2-in-1 Shampoo + Conditioner"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Bhringraj and Japa strengthen the hair shaft while Jatamansi calms the scalp — cleanses and conditions in one step, so wash day stops being a fight over tangles.</p>"
        },
        {
          "type": "text",
          "id": "chips",
          "label": "Ingredient chips",
          "info": "Comma separated.",
          "default": "Bhringraj, Japa, Jatamansi"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Ritual lines",
      "blocks": [
        { "type": "ritual" },
        { "type": "ritual" },
        { "type": "ritual" }
      ]
    }
  ]
}
{% endschema %}
