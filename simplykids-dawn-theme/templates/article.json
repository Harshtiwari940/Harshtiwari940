{
  "sections": {
    "main": {
      "type": "main-article",
      "blocks": {
        "featured_image": {
          "type": "featured_image",
          "settings": {
            "image_height": "adapt"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "blog_show_date": true,
            "blog_show_author": false
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "content": {
          "type": "content",
          "settings": {}
        }
      },
      "block_order": [
        "featured_image",
        "title",
        "share",
        "content"
      ],
      "settings": {}
    },
    "sk_newsletter": {
      "type": "sk-newsletter-offer",
      "settings": {
        "color_scheme": "scheme-12",
        "heading": "10% off your first order",
        "heading_size": "h1",
        "subheading": "Expert tips, new launches, and stories for growing kids. No spam — ever.",
        "placeholder": "your@email.com",
        "button_label": "Subscribe",
        "success_text": "Thanks — your discount is on its way to your inbox.",
        "padding_top": 56,
        "padding_bottom": 56
      }
    },
    "sk_trust": {
      "type": "sk-trust-badges",
      "blocks": {
        "promise_shipping": {
          "type": "promise",
          "settings": {
            "icon": "cart",
            "title": "Free Shipping",
            "text": "On orders over ₹999"
          }
        },
        "promise_cod": {
          "type": "promise",
          "settings": {
            "icon": "cash",
            "title": "COD Available",
            "text": "Pay when it arrives"
          }
        },
        "promise_returns": {
          "type": "promise",
          "settings": {
            "icon": "return",
            "title": "No Question Asked",
            "text": "Returns & Exchange"
          }
        },
        "pay_upi": {
          "type": "payment_mark",
          "settings": {
            "label": "UPI",
            "italic": false
          }
        },
        "pay_visa": {
          "type": "payment_mark",
          "settings": {
            "label": "VISA",
            "italic": true
          }
        },
        "pay_mc": {
          "type": "payment_mark",
          "settings": {
            "label": "Mastercard",
            "italic": false
          }
        },
        "pay_rupay": {
          "type": "payment_mark",
          "settings": {
            "label": "RuPay",
            "italic": false
          }
        }
      },
      "block_order": [
        "promise_shipping",
        "promise_cod",
        "promise_returns",
        "pay_upi",
        "pay_visa",
        "pay_mc",
        "pay_rupay"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "columns": 3,
        "protection_text": "100% Payment Protection, Easy Return Policy",
        "padding_top": 64,
        "padding_bottom": 64
      }
    }
  },
  "order": [
    "main",
    "sk_newsletter",
    "sk_trust"
  ]
}
