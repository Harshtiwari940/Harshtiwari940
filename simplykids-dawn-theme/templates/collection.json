{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "color_scheme": "scheme-1"
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 16,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "none",
        "enable_filtering": true,
        "filter_type": "horizontal",
        "enable_sorting": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "sk_pills": {
      "type": "sk-collection-pills",
      "blocks": {
        "pill_all": {
          "type": "pill",
          "settings": {
            "label": "All",
            "link": "shopify://collections/all"
          }
        },
        "pill_hair": {
          "type": "pill",
          "settings": {
            "label": "Hair & scalp"
          }
        },
        "pill_body": {
          "type": "pill",
          "settings": {
            "label": "Body & bath"
          }
        },
        "pill_bedtime": {
          "type": "pill",
          "settings": {
            "label": "Bedtime & massage"
          }
        }
      },
      "block_order": [
        "pill_all",
        "pill_hair",
        "pill_body",
        "pill_bedtime"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "aria_label": "Product categories",
        "padding_top": 24,
        "padding_bottom": 8
      }
    },
    "sk_trust": {
      "type": "sk-trust-badges",
      "blocks": {
        "promise_shipping": {
          "type": "promise",
          "settings": {
            "icon": "cart",
            "title": "Free Shipping",
            "text": "On orders over ₹999"
          }
        },
        "promise_cod": {
          "type": "promise",
          "settings": {
            "icon": "cash",
            "title": "COD Available",
            "text": "Pay when it arrives"
          }
        },
        "promise_returns": {
          "type": "promise",
          "settings": {
            "icon": "return",
            "title": "No Question Asked",
            "text": "Returns & Exchange"
          }
        },
        "pay_upi": {
          "type": "payment_mark",
          "settings": {
            "label": "UPI",
            "italic": false
          }
        },
        "pay_visa": {
          "type": "payment_mark",
          "settings": {
            "label": "VISA",
            "italic": true
          }
        },
        "pay_mc": {
          "type": "payment_mark",
          "settings": {
            "label": "Mastercard",
            "italic": false
          }
        },
        "pay_rupay": {
          "type": "payment_mark",
          "settings": {
            "label": "RuPay",
            "italic": false
          }
        }
      },
      "block_order": [
        "promise_shipping",
        "promise_cod",
        "promise_returns",
        "pay_upi",
        "pay_visa",
        "pay_mc",
        "pay_rupay"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "columns": 3,
        "protection_text": "100% Payment Protection, Easy Return Policy",
        "padding_top": 64,
        "padding_bottom": 64
      }
    }
  },
  "order": [
    "banner",
    "sk_pills",
    "product-grid",
    "sk_trust"
  ]
}
