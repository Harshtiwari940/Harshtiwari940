{
  "sections": {
    "sk_hero": {
      "type": "sk-page-hero",
      "settings": {
        "show_heading": true,
        "color_scheme": "scheme-1",
        "text_align": "left",
        "narrow": true,
        "heading": "Privacy Policy",
        "heading_tag": "h1",
        "heading_size": "h1",
        "padding_top": 80,
        "padding_bottom": 16
      }
    },
    "sk_body": {
      "type": "sk-rich-content",
      "blocks": {
        "meta": {
          "type": "meta",
          "settings": {
            "text": "Last updated: January 2026"
          }
        },
        "t_1": {
          "type": "text",
          "settings": {
            "text": "<p>Omakase Enterprises LLP (\"Simply Kids\", \"we\", \"us\") is committed to protecting the privacy of everyone who visits simplykids.in, including children whose parents or guardians shop with us on their behalf.</p>"
          }
        },
        "h_2": {
          "type": "heading",
          "settings": {
            "text": "What we collect",
            "level": "h3"
          }
        },
        "t_2": {
          "type": "text",
          "settings": {
            "text": "<p>Order and contact details you provide at checkout (name, address, phone, email); browsing data via cookies and analytics; and, where you choose to share it, your child's first name and age for personalisation features such as the Community gallery or age-based product recommendations.</p>"
          }
        },
        "h_3": {
          "type": "heading",
          "settings": {
            "text": "Children's data",
            "level": "h3"
          }
        },
        "t_3": {
          "type": "text",
          "settings": {
            "text": "<p>Simply Kids products are for children aged 4–12, but our website and accounts are operated by parents/guardians. We do not knowingly collect personal data directly from children without verified parental consent, and any child-related information (like a first name and age submitted to \"Be the Pride\") is provided by the parent or guardian at their discretion, for the sole purpose of that feature.</p>"
          }
        },
        "h_4": {
          "type": "heading",
          "settings": {
            "text": "How we use your data",
            "level": "h3"
          }
        },
        "t_4": {
          "type": "text",
          "settings": {
            "text": "<p>To process and ship orders, respond to queries, personalise the shopping experience, and — only with consent via cookie preferences — for marketing and analytics.</p>"
          }
        },
        "h_5": {
          "type": "heading",
          "settings": {
            "text": "Your rights",
            "level": "h3"
          }
        },
        "t_5": {
          "type": "text",
          "settings": {
            "text": "<p>You may request access to, correction of, or deletion of your personal data at any time by writing to support@simplykids.in.</p>"
          }
        },
        "h_6": {
          "type": "heading",
          "settings": {
            "text": "Contact",
            "level": "h3"
          }
        },
        "t_6": {
          "type": "text",
          "settings": {
            "text": "<p>Omakase Enterprises LLP, Primarc Chambers, Unit OU-114, 1839 Laskarhat, Tagore Park, E. M. Bypass, Kolkata – 700039. support@simplykids.in · +91-6297450751</p>"
          }
        }
      },
