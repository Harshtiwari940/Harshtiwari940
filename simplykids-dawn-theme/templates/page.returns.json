            "text": "On orders over ₹999"
          }
        },
        "promise_cod": {
          "type": "promise",
          "settings": {
            "icon": "cash",
            "title": "COD Available",
            "text": "Pay when it arrives"
          }
        },
        "promise_returns": {
          "type": "promise",
          "settings": {
            "icon": "return",
            "title": "No Question Asked",
            "text": "Returns & Exchange"
          }
        },
        "pay_upi": {
