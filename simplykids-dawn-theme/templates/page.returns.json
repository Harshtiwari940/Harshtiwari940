{
  "sections": {
    "sk_hero": {
      "type": "sk-page-hero",
      "settings": {
        "show_heading": true,
        "color_scheme": "scheme-1",
        "text_align": "left",
        "narrow": true,
        "heading": "Return & Refund Policy",
        "heading_tag": "h1",
        "heading_size": "h1",
        "padding_top": 80,
        "padding_bottom": 16
      }
    },
    "sk_body": {
      "type": "sk-rich-content",
      "blocks": {
        "meta": {
          "type": "meta",
          "settings": {
            "text": "No question asked returns & exchange"
          }
        },
        "h_1": {
          "type": "heading",
          "settings": {
            "text": "7-day returns",
            "level": "h3"
          }
        },
        "t_1": {
          "type": "text",
          "settings": {
            "text": "<p>If you're not happy with your order, you can return any unopened, sealed product within 7 days of delivery for a full refund or exchange — no questions asked.</p>"
          }
        },
        "h_2": {
          "type": "heading",
          "settings": {
            "text": "How to start a return",
            "level": "h3"
          }
        },
        "t_2": {
          "type": "text",
          "settings": {
            "text": "<p>Write to support@simplykids.in with your order number, or use the Contact Us form. Our team will arrange a reverse pickup where available, or share drop-off instructions.</p>"
          }
        },
        "h_3": {
          "type": "heading",
          "settings": {
            "text": "Refunds",
            "level": "h3"
          }
        },
        "t_3": {
          "type": "text",
          "settings": {
            "text": "<p>Once we receive and inspect the returned item, refunds are processed to your original payment method within 5–7 business days. COD orders are refunded via bank transfer or UPI.</p>"
          }
        },
        "h_4": {
          "type": "heading",
          "settings": {
            "text": "Damaged or incorrect items",
            "level": "h3"
          }
        },
        "t_4": {
          "type": "text",
          "settings": {
            "text": "<p>If your order arrives damaged or incorrect, contact us within 48 hours of delivery with photos, and we'll replace it at no extra cost.</p>"
          }
        }
      },
      "block_order": [
        "meta",
        "h_1",
        "t_1",
        "h_2",
        "t_2",
        "h_3",
        "t_3",
        "h_4",
        "t_4"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "max_width": 80,
        "padding_top": 0,
        "padding_bottom": 80
      }
    },
    "sk_page_body": {
      "type": "sk-page-content",
      "settings": {
        "color_scheme": "scheme-1",
        "max_width": 80,
        "center": false,
        "padding_top": 0,
        "padding_bottom": 48
      }
    },
    "sk_trust": {
