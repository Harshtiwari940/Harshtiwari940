      "blocks": {
        "q_sensitive": {
          "type": "question",
          "settings": {
            "question": "Is this safe for sensitive skin?",
            "answer": "<p>Yes — every product is pH 5.5-balanced and dermatologically tested on children in the 4–12 range.</p>",
            "open": false
          }
        },
        "q_vs_baby": {
          "type": "question",
          "settings": {
            "question": "How is this different from baby products?",
            "answer": "<p>Baby formulas are built for skin that hasn't developed its own oil balance yet. By age four that changes.</p>",
            "open": false
          }
        },
        "q_animals": {
          "type": "question",
          "settings": {
            "question": "Do you test on animals?",
            "answer": "<p>No. Every product is vegan and cruelty-free.</p>",
            "open": false
          }
        },
        "q_returns": {
          "type": "question",
          "settings": {
            "question": "What's your return policy?",
            "answer": "<p>7-day returns on unopened, sealed products.</p>",
            "open": false
          }
        },
        "q_cod": {
          "type": "question",
          "settings": {
            "question": "Do you offer cash on delivery?",
            "answer": "<p>Yes, COD is available alongside UPI, cards, net banking, wallets, and no-cost EMI.</p>",
            "open": false
          }
        },
        "q_nuskhe": {
          "type": "question",
          "settings": {
            "question": "What are the “Naniji ke Nuskhe” that you talk about?",
            "answer": "<p>We are a mother-daughter duo with a legacy of care. All our products are toxin-free, safe, and dermatologically tested.</p>",
            "open": false
          }
        },
        "q_why_sk": {
          "type": "question",
          "settings": {
            "question": "Why should I prefer Simply Kids over any other product available in the market?",
            "answer": "<p>The market is flooded with baby products, but there are pretty much no products made specifically for children once they grow past toddlerhood into the pre-teen years. Our products are dermatologically tested and contain only the finest, ethically sourced, minimally processed ingredients.</p>",
            "open": false
          }
        },
        "q_age_range": {
          "type": "question",
          "settings": {
            "question": "What is the recommended age range for Simply Kids products?",
            "answer": "<p>The Simply Kids range has been specially developed for children aged 4–12 years.</p>",
            "open": false
          }
        },
        "q_others": {
          "type": "question",
          "settings": {
            "question": "Can babies, teenagers and adults also use your products?",
            "answer": "<p>As the name would suggest, Simply Kids products are formulated to specifically suit the personal care requirements of your 4–12 year olds.</p>",
            "open": false
          }
        },
        "q_natural": {
          "type": "question",
          "settings": {
            "question": "Do your products use natural ingredients?",
            "answer": "<p>As far as possible, yes. Our range of natural ingredients includes almond oil, jojoba oil, bhringraj, and many more.</p>",
            "open": false
          }
        }
      },
