{%- liquid
  case section.settings.content_width
    when 'narrow'
      assign wrap_style = 'max-width:76rem;margin-left:auto;margin-right:auto;'
    when 'medium'
      assign wrap_style = 'max-width:100rem;margin-left:auto;margin-right:auto;'
    when 'full'
      assign wrap_style = 'max-width:none;'
    else
      assign wrap_style = ''
  endcase
-%}
<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  <div class="page-width" style="{{ wrap_style }}text-align: {{ section.settings.text_align }};">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sk-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="sk-section__title" style="font-size: {{ section.settings.heading_font_size }}rem;">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="sk-section__text" style="font-size: {{ section.settings.text_font_size }}rem; opacity: .85;">
        {{ section.settings.subheading }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div style="display:flex;gap:1.2rem;flex-wrap:wrap;margin:2rem 0;{% if section.settings.text_align == 'center' %}justify-content:center;{% elsif section.settings.text_align == 'right' %}justify-content:flex-end;{% endif %}">
        {%- for block in section.blocks -%}
          <span class="sk-pill sk-pill--age" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
      <div class="sk-buttons{% if section.settings.text_align == 'center' %} sk-buttons--center{% endif %}" style="margin-top:1.6rem;">
        {% render 'button', label: section.settings.button_label, link: section.settings.button_link, style: section.settings.button_style %}
        {% render 'button', label: section.settings.button_2_label, link: section.settings.button_2_link, style: section.settings.button_2_style %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "sk-rich-text-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Talk about your brand"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 once per page for SEO.",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.4,
      "max": 5.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.6
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Text",
      "default": "<p>Use this text to share information about your brand with your customers.</p>"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "min": 1.2,
      "max": 2.4,
      "step": 0.1,
      "unit": "rem",
      "label": "Text size",
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button 1 label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button 1 style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "hero",
          "label": "Hero"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Button 2 style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "hero",
          "label": "Hero"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "outline"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Top padding",
      "default": 5.0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 4.0
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Safe"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
