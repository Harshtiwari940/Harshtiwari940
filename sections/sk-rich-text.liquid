{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="sk-prose" style="max-width: {{ section.settings.max_width }}rem; margin: 0 auto;">
      {%- if section.settings.heading != blank -%}
        <h1 style="font-size: 2.8rem; margin: 0 0 0.6rem;">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="sk-prose__note">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {{ block.settings.text }}
        </div>
      {%- endfor -%}

      {%- if section.settings.show_page_content and page.content != blank -%}
        <div class="rte">{{ page.content }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Rich text",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 30,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "default": false,
      "label": "Also show the page's own content",
      "info": "Appends whatever you have written on this page in the Shopify admin."
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 50,
      "max": 124,
      "step": 2,
      "unit": "rem",
      "label": "Content width",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "passage",
      "name": "Passage",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Rich text",
      "blocks": [{ "type": "passage" }, { "type": "passage" }]
    }
  ]
}
{% endschema %}
