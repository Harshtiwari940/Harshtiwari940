<div
  class="sk-image-banner"
  style="
    position:relative;
    min-height: {{ section.settings.min_height }}vh;
    display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;
  "
>
  {%- if section.settings.image != blank or section.settings.image_asset != blank -%}
    {% render 'image-or-asset',
      image: section.settings.image,
      asset: section.settings.image_asset,
      alt: section.settings.heading,
      widths: '600,900,1200,1600,2000,2400',
      sizes: '100vw',
      img_style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;' %}
  {%- else -%}
    <div style="position:absolute;inset:0;background:var(--sk-blue-deep);"></div>
  {%- endif -%}

  {%- liquid
    assign a_edge = section.settings.overlay_opacity | divided_by: 100.0
    assign a_center = a_edge | times: 0.95
    assign a_mid = a_edge | times: 0.89
    assign c_center = section.settings.overlay_color | color_modify: 'alpha', a_center
    assign c_mid = section.settings.overlay_color | color_modify: 'alpha', a_mid
    assign c_edge = section.settings.overlay_color | color_modify: 'alpha', a_edge
  -%}
  <div
    style="
      position:absolute;inset:0;
      {% if section.settings.overlay_style == 'radial' -%}
        background: radial-gradient(ellipse at center, {{ c_center }} 0%, {{ c_mid }} 55%, {{ c_edge }} 100%);
      {%- else -%}
        background: {{ c_edge }};
      {%- endif %}
    "
  ></div>

  <div style="position:relative;z-index:2;color:{{ section.settings.text_color }};max-width:70rem;padding:4rem 3rem;">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sk-eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} style="color:{{ section.settings.text_color }};font-size: {{ section.settings.heading_font_size }}rem;">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="sk-section__text" style="font-size: {{ section.settings.text_font_size }}rem;opacity:.92;">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.footnote != blank -%}
      <div class="sk-section__text" style="font-size:1.3rem;opacity:.75;">{{ section.settings.footnote }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="sk-buttons sk-buttons--center" style="margin-top:2rem;">
        {% render 'button', label: section.settings.button_label, link: section.settings.button_link, style: section.settings.button_style %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "sk-image-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Built-in image file",
      "info": "Falls back to an image file shipped with the theme when no image is chosen above. Clear it to show nothing.",
      "default": "banner-why-4-to-12.jpg"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Minimum height",
      "default": 50
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Why 4 to 12 matters"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Baby care's too mild. Adult care's too harsh."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.8,
      "max": 5.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 3.4
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We formulate for the nine years everyone else skips — tested on the children it's actually made for, not adults scaled down.</p>"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "min": 1.2,
      "max": 2.6,
      "step": 0.1,
      "unit": "rem",
      "label": "Text size",
      "default": 1.6
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Small text below"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "hero",
          "label": "Hero"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "outline"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow label",
      "default": "#BEE7F5"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "default": "#001E3A"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "radial",
          "label": "Radial fade"
        }
      ],
      "default": "radial"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 85
    }
  ],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}
