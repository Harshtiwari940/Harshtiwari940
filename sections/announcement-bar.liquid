{%- comment -%}
  Announcement bar. Each message is a block, so merchants can add, remove,
  reorder or hide messages from the theme editor.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div
    class="pv-announce"
    style="
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      {% if section.settings.font_size %}font-size: {{ section.settings.font_size }}rem;{% endif %}
    "
  >
    {%- for block in section.blocks -%}
      {%- if block.settings.text != blank -%}
        {%- unless forloop.first -%}
          &nbsp;{{ section.settings.separator }}&nbsp;
        {%- endunless -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" style="color:inherit;">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "sk-announcement-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "linear-gradient(100deg, #FCE0EC 0%, #FAD3E6 50%, #F6B1D4 100%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4A4744"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between messages",
      "default": "·"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 1.0,
      "max": 1.8,
      "step": 0.1,
      "unit": "rem",
      "label": "Text size",
      "default": 1.3
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping over ₹999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping over ₹999" } },
        { "type": "message", "settings": { "text": "Cash on delivery" } },
        { "type": "message", "settings": { "text": "Rated 4.8 across 112 verified reviews" } }
      ]
    }
  ]
}
{% endschema %}
