{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div style="max-width: {{ section.settings.max_width }}rem; margin: 0 auto;">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="sk-section-head">
          {%- if section.settings.eyebrow != blank -%}
            <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2>{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="sk-timeline">
        {%- for block in section.blocks -%}
          <div class="sk-timeline__item" {{ block.shopify_attributes }}>
            {%- if block.settings.year != blank -%}
              <div class="sk-timeline__year">{{ block.settings.year | escape }}</div>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="sk-timeline__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Timeline",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "default": "Our Journey", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "range",
      "id": "max_width",
      "min": 50,
      "max": 124,
      "step": 2,
      "unit": "rem",
      "label": "Content width",
      "default": 90
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "year", "default": "2018", "label": "Year" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Timeline",
      "blocks": [{ "type": "milestone" }, { "type": "milestone" }, { "type": "milestone" }]
    }
  ]
}
{% endschema %}
