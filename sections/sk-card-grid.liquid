{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="sk-section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sk-card-grid sk-card-grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div
          class="sk-tool-card{% if block.settings.accent %} sk-card--accent{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.title != blank -%}
            <h3{% if block.settings.blue_title %} style="color: #004987;"{% endif %}>
              {{- block.settings.title | escape -}}
            </h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div>{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.hashtag != blank -%}
            <p class="sk-card__hash">{{ block.settings.hashtag | escape }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a
              href="{{ block.settings.button_link | default: '#' }}"
              class="sk-btn sk-btn--primary"
              style="margin-top: auto;"
            >
              {{- block.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Card grid",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "text", "label": "Subtext" },
    {
      "type": "select",
      "id": "columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3",
      "label": "Columns"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "hashtag", "label": "Hashtag" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "checkbox", "id": "blue_title", "default": false, "label": "Midnight Blue title" },
        {
          "type": "checkbox",
          "id": "accent",
          "default": false,
          "label": "Pink accent card",
          "info": "Reserve for the sanctioned accent placements."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Card grid",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
