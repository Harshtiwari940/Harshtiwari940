{%- comment -%}
  Cart. Uses Shopify's real cart object and cart form, so totals, taxes,
  discounts and checkout are live.
{%- endcomment -%}
<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  <div class="page-width" style="max-width:90rem;">
    {%- if section.settings.show_breadcrumb -%}
      <p class="pv-crumb">
        <a href="{{ routes.root_url }}" style="color:inherit;">{{ section.settings.home_label }}</a> / {{ section.settings.cart_label }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="sk-section__title" style="font-size: {{ section.settings.heading_font_size }}rem;">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if cart.item_count == 0 -%}
      <div style="padding:4rem 0;text-align:center;">
        <p style="opacity:.8;font-size:1.6rem;">{{ section.settings.empty_text }}</p>
        {% render 'button', label: section.settings.empty_button_label, link: section.settings.empty_button_link, style: 'primary' %}
      </div>
    {%- else -%}
      {%- form 'cart', cart, id: 'CartForm' -%}
        <div class="pv-cart-grid" style="margin-top:2rem;">
          <div>
            {%- for item in cart.items -%}
              <div style="display:flex;gap:1.4rem;padding:1.4rem 0;border-bottom:1px solid rgba(18,59,74,.1);align-items:center;flex-wrap:wrap;">
                <a href="{{ item.url }}">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 240 | image_tag:
                      loading: 'lazy',
                      widths: '80,160,240',
                      alt: item.title,
                      style: 'width:80px;height:auto;border-radius:12px;' }}
                  {%- endif -%}
                </a>
                <div style="flex:1;min-width:18rem;">
                  <a href="{{ item.url }}" style="color:inherit;text-decoration:none;"><strong>{{ item.product.title }}</strong></a>
                  {%- unless item.variant.title == 'Default Title' -%}
                    <div style="opacity:.6;font-size:1.3rem;">{{ item.variant.title }}</div>
                  {%- endunless -%}
                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    {%- for discount in item.line_level_discount_allocations -%}
                      <div style="color:var(--sk-blue-deep);font-size:1.2rem;">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</div>
                    {%- endfor -%}
                  {%- endif -%}
                  <div style="display:flex;align-items:center;gap:1rem;margin-top:.6rem;">
                    <label class="sk-visually-hidden" for="Qty-{{ item.index | plus: 1 }}">Quantity</label>
                    <input
                      id="Qty-{{ item.index | plus: 1 }}"
                      class="sk-field"
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      style="max-width:8rem;padding:.6rem;"
                    >
                    <a href="{{ item.url_to_remove }}" style="font-size:1.2rem;opacity:.7;color:inherit;">{{ section.settings.remove_label }}</a>
                  </div>
                </div>
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
            {%- endfor -%}

            {%- if settings.show_cart_note -%}
              <label class="sk-label" for="CartNote">{{ section.settings.note_label }}</label>
              <textarea class="sk-field" id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
            {%- endif -%}

            <div style="margin-top:1.6rem;">
              <button type="submit" name="update" class="sk-btn sk-btn--outline" style="border:0;cursor:pointer;">
                {{ section.settings.update_label }}
              </button>
            </div>
          </div>

          <div class="sk-tool-card">
            {%- if section.settings.summary_heading != blank -%}
              <h3>{{ section.settings.summary_heading }}</h3>
            {%- endif -%}

            <div style="display:flex;justify-content:space-between;margin:.6rem 0;">
              <span>{{ section.settings.subtotal_label }}</span>
              <span>{{ cart.items_subtotal_price | money }}</span>
            </div>

            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                <div style="display:flex;justify-content:space-between;margin:.6rem 0;color:var(--sk-blue-deep);">
                  <span>{{ discount.title }}</span>
                  <span>−{{ discount.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}

            {%- if section.settings.shipping_note != blank -%}
              <div style="display:flex;justify-content:space-between;margin:.6rem 0;">
                <span>{{ section.settings.shipping_label }}</span>
                <span>{{ section.settings.shipping_note }}</span>
              </div>
            {%- endif -%}

            <div style="display:flex;justify-content:space-between;margin:1rem 0;font-size:1.6rem;font-weight:700;border-top:1px solid rgba(18,59,74,.1);padding-top:1rem;">
              <span>{{ section.settings.total_label }}</span>
              <span>{{ cart.total_price | money_with_currency }}</span>
            </div>

            <p style="font-size:1.2rem;opacity:.6;">{{ section.settings.tax_note }}</p>

            <button type="submit" name="checkout" class="sk-btn sk-btn--{{ section.settings.button_style }}" style="width:100%;border:0;cursor:pointer;">
              {{ section.settings.checkout_label }}
            </button>

            {%- if section.settings.below_checkout != blank -%}
              <div class="sk-section__text" style="font-size:1.2rem;opacity:.7;margin-top:1rem;text-align:center;">
                {{ section.settings.below_checkout }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endform -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "sk-cart-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Review & checkout"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.6,
      "max": 4.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.4
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart label",
      "default": "Bag"
    },
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Message",
      "default": "Your bag is empty."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Button label",
      "default": "Shop the range"
    },
    {
      "type": "url",
      "id": "empty_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "remove_label",
      "label": "Remove",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "update_label",
      "label": "Update cart",
      "default": "Update bag"
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "Order note",
      "info": "Shown only when order notes are enabled in Theme settings > Cart.",
      "default": "Order note"
    },
    {
      "type": "header",
      "content": "Order summary"
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "Heading",
      "default": "Order summary"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping",
      "default": "Shipping"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping value",
      "default": "Calculated at checkout"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Tax note",
      "default": "Taxes included. Shipping calculated at checkout."
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button",
      "default": "Place order"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "hero",
          "label": "Hero"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "hero"
    },
    {
      "type": "richtext",
      "id": "below_checkout",
      "label": "Text below checkout"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Top padding",
      "default": 3.6
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 3.6
    }
  ],
  "presets": [
    {
      "name": "Cart"
    }
  ]
}
{% endschema %}
