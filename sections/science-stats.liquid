        },
        {
          "type": "text",
          "id": "col_1",
          "label": "Column 1 heading",
          "default": "Result"
        },
        {
          "type": "text",
          "id": "col_2",
          "label": "Column 2 heading",
          "default": "Product"
        },
        {
          "type": "text",
          "id": "col_3",
          "label": "Column 3 heading",
          "default": "Study"
        },
        {
          "type": "textarea",
          "id": "rows",
