{%- liquid
  case section.settings.content_width
    when 'narrow'
      assign wrap_style = 'max-width:76rem;margin-left:auto;margin-right:auto;'
    when 'medium'
      assign wrap_style = 'max-width:100rem;margin-left:auto;margin-right:auto;'
    when 'full'
      assign wrap_style = 'max-width:none;'
    else
      assign wrap_style = ''
  endcase
-%}
<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  <div class="page-width" style="{{ wrap_style }}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sk-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="sk-section__title" style="font-size: {{ section.settings.heading_font_size }}rem;">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="sk-section__text" style="opacity:.85;max-width:60rem;">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'body' -%}
          <div {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 style="margin-top:2rem;">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="sk-section__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'chips' -%}
          <div {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 style="margin-top:2rem;">{{ block.settings.heading }}</h3>
            {%- endif -%}
            <div>
              {%- assign rows = block.settings.chips | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign parts = row | strip | split: '|' -%}
                {%- if parts[0] != blank -%}
                  <span class="sk-ingredient-chip"{% if parts[1] %} data-tip="{{ parts[1] | strip | escape }}"{% endif %}>{{ parts[0] | strip }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

        {%- when 'stats' -%}
          <div {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 style="margin-top:2rem;">{{ block.settings.heading }}</h3>
            {%- endif -%}
            <table class="sk-science-stats">
              <thead>
                <tr>
                  <th>{{ block.settings.col_1 }}</th>
                  <th>{{ block.settings.col_2 }}</th>
                  <th>{{ block.settings.col_3 }}</th>
                </tr>
              </thead>
              <tbody>
                {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
                {%- for row in rows -%}
                  {%- assign cells = row | strip | split: '|' -%}
                  {%- if cells[0] != blank -%}
                    <tr>
                      <td class="stat-value">{{ cells[0] | strip }}</td>
                      <td>{{ cells[1] | strip }}</td>
                      <td>{{ cells[2] | strip }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>

      {%- endcase -%}
    {%- endfor -%}

    {%- if section.settings.footnote != blank -%}
      <p style="font-size:1.2rem;opacity:.6;">{{ section.settings.footnote }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="sk-buttons" style="margin-top:1.6rem;">
        {% render 'button', label: section.settings.button_label, link: section.settings.button_link, style: section.settings.button_style %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Science and stats",
  "tag": "section",
  "class": "sk-science-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Why 4 to 12 matters"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The in-between years, finally taken seriously."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.6,
      "max": 4.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.2
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>By age four, a child's skin picks up its own oil profile. By twelve, that same skin is nearly adult. Most brands skip both moments and sell the years in between.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Explore the science"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "hero",
          "label": "Hero"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "7"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
