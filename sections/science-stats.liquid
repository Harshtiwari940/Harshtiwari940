    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 3.6
    }
  ],
  "blocks": [
    {
      "type": "body",
      "name": "Heading and text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "pH 5.5-balanced"
        },
        {
          "type": "richtext",
          "id": "text",
