{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.heading != blank -%}
    <div class="sk-section-head" style="padding: 0 2rem;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    <div
      class="sk-ritual-grid{% cycle '', ' sk-ritual-grid--rev' %}"
      {{ block.shopify_attributes }}
    >
      <div class="sk-ritual__media">
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1400',
              sizes: '(min-width: 990px) 45vw, 100vw',
              alt: block.settings.image.alt | default: block.settings.title | escape
          }}
        {%- else -%}
          {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="sk-ritual__copy">
        {%- if block.settings.eyebrow != blank -%}
          <div class="sk-ritual__eyebrow">{{ block.settings.eyebrow | escape }}</div>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h3 class="sk-ritual__title">{{ block.settings.title | escape }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="sk-ritual__text">{{ block.settings.text }}</div>
        {%- endif -%}

        {%- if block.settings.chips != blank -%}
          <div class="sk-ritual__chips">
            {%- assign chips = block.settings.chips | split: ',' -%}
            {%- for chip in chips -%}
              <span class="sk-ritual__chip">{{ chip | strip | escape }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if block.settings.button_label != blank -%}
          <a
            href="{{ block.settings.button_link | default: '#' }}"
            class="sk-btn sk-btn--primary"
            style="margin-top: 2rem;"
          >
            {{- block.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "SK Ritual lines",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    { "type": "text", "id": "eyebrow", "default": "The Simply Kids ritual system", "label": "Eyebrow" },
    {
      "type": "text",
      "id": "heading",
      "default": "Three rituals. Nine years. One routine that actually fits.",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "ritual",
      "name": "Ritual",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "default": "Ritual 01 — the wash-day fix", "label": "Eyebrow" },
        { "type": "text", "id": "title", "default": "2-in-1 Shampoo + Conditioner", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        {
          "type": "text",
          "id": "chips",
          "default": "Bhringraj, Japa, Jatamansi",
          "label": "Ingredient chips",
          "info": "Separate with commas."
        },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Ritual lines",
      "blocks": [{ "type": "ritual" }, { "type": "ritual" }, { "type": "ritual" }]
    }
  ]
}
{% endschema %}
