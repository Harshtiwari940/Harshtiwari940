{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="sk-section-head" style="margin-bottom: 2.4rem;">
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="sk-medallion-row">
      {%- for block in section.blocks -%}
        <figure class="sk-medallion" style="margin: 0;" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 270
              | image_tag:
                loading: 'lazy',
                widths: '90, 180, 270',
                alt: block.settings.image.alt | default: block.settings.label | escape
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.show_label and block.settings.label != blank -%}
            <figcaption>{{ block.settings.label | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Medallions",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "medallion",
      "name": "Medallion",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "default": "Dermatologically Tested", "label": "Label" },
        { "type": "checkbox", "id": "show_label", "default": false, "label": "Show label under image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Medallions",
      "blocks": [
        { "type": "medallion" },
        { "type": "medallion" },
        { "type": "medallion" },
        { "type": "medallion" },
        { "type": "medallion" },
        { "type": "medallion" }
      ]
    }
  ]
}
{% endschema %}
