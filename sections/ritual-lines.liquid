        },
        {
          "type": "text",
          "id": "chips",
          "label": "Ingredient chips",
          "info": "Separate with commas.",
          "default": "Bhringraj, Japa, Jatamansi"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "hero",
              "label": "Hero"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ritual rows",
      "blocks": [
        {
          "type": "ritual"
        },
        {
          "type": "ritual"
        },
        {
          "type": "ritual"
        }
      ]
    }
  ]
}
{% endschema %}
