{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.heading != blank -%}
    <div class="page-width sk-section-head" style="margin-bottom: 3rem;">
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="sk-jrz-grid">
      {%- for block in section.blocks -%}
        <div class="sk-jrz-zone sk-jrz-zone--{{ block.settings.tone }}" {{ block.shopify_attributes }}>
          {%- if block.settings.flag != blank -%}
            <span class="sk-jrz-flag">
              {%- if block.settings.tone == 'right' -%}
                &#10003;
              {%- else -%}
                &#10005;
              {%- endif %}
              {{ block.settings.flag | escape }}
            </span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Just-right zone",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Not too mild. Not too harsh. Just right for 4–12.",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "zone",
      "name": "Zone",
      "settings": [
        {
          "type": "select",
          "id": "tone",
          "options": [
            { "value": "mild", "label": "Too mild" },
            { "value": "right", "label": "Just right" },
            { "value": "harsh", "label": "Too harsh" }
          ],
          "default": "mild",
          "label": "Zone"
        },
        { "type": "text", "id": "flag", "default": "Not for 4–12", "label": "Flag label" },
        { "type": "text", "id": "title", "default": "Baby care", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Just-right zone",
      "blocks": [
        { "type": "zone", "settings": { "tone": "mild" } },
        { "type": "zone", "settings": { "tone": "right" } },
        { "type": "zone", "settings": { "tone": "harsh" } }
      ]
    }
  ]
}
{% endschema %}
