{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div style="max-width: {{ section.settings.max_width }}rem; margin: 0 auto;">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="sk-section-head" style="margin-bottom: 3rem;">
          {%- if section.settings.eyebrow != blank -%}
            <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2>{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        <div class="sk-story-gen" {{ block.shopify_attributes }}>
          <div class="sk-story-gen__badge">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 160
                | image_tag:
                  loading: 'lazy',
                  widths: '52, 104, 160',
                  style: 'width: 100%; height: 100%; object-fit: cover; border-radius: 50%;',
                  alt: block.settings.name | escape
              }}
            {%- else -%}
              {{ block.settings.badge | default: forloop.index | escape }}
            {%- endif -%}
          </div>
          <div>
            {%- if block.settings.name != blank -%}
              <h3 class="sk-story-gen__name">{{ block.settings.name | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.role != blank -%}
              <span class="sk-story-gen__role">{{ block.settings.role | escape }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Founders",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "default": "Meet Our Founders", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "range",
      "id": "max_width",
      "min": 50,
      "max": 124,
      "step": 2,
      "unit": "rem",
      "label": "Content width",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "badge", "label": "Badge text", "info": "Used when there is no photo." },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "textarea", "id": "text", "label": "Bio" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Founders",
      "blocks": [{ "type": "founder" }, { "type": "founder" }, { "type": "founder" }]
    }
  ]
}
{% endschema %}
