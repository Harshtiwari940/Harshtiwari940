{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="sk-submit-form">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- form 'contact', id: 'SkCommunityForm', class: 'sk-submit-form__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status-list form__message" tabindex="-1" autofocus>
            <span class="svg-wrapper">{{- 'icon-success.svg' | inline_asset_content -}}</span>
            {{ section.settings.success_message | escape }}
          </p>
        {%- elsif form.errors -%}
          <div class="form__message" role="alert">
            <h3 class="form-status caption-large" tabindex="-1" autofocus>
              <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
              {{ 'templates.contact.form.error_heading' | t }}
            </h3>
            <ul class="form-status-list caption-large" role="list">
              {%- for field in form.errors -%}
                <li>
                  <a href="#SkCommunityForm-{{ field }}" class="link">
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[submission_type]" value="Be the Pride entry">

        <label for="SkCommunityForm-child-name">{{ section.settings.label_name | escape }}</label>
        <input
          type="text"
          id="SkCommunityForm-child-name"
          class="sk-field"
          name="contact[child_first_name]"
          autocomplete="off"
        >

        <label for="SkCommunityForm-child-age">{{ section.settings.label_age | escape }}</label>
        <select id="SkCommunityForm-child-age" class="sk-field" name="contact[child_age]">
          <option value="">{{ section.settings.age_placeholder | escape }}</option>
          {%- for age in (4..12) -%}
            <option value="{{ age }}">{{ age }}</option>
          {%- endfor -%}
        </select>

        <label for="SkCommunityForm-email">{{ section.settings.label_email | escape }}</label>
        <input
          type="email"
          id="SkCommunityForm-email"
          class="sk-field"
          name="contact[email]"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >

        <label for="SkCommunityForm-message">{{ section.settings.label_message | escape }}</label>
        <textarea id="SkCommunityForm-message" class="sk-field" name="contact[body]" rows="4"></textarea>

        <button type="submit" class="sk-btn sk-btn--hero sk-btn--full" style="margin-top: 1.6rem;">
          {{- section.settings.button_label | escape -}}
        </button>

        {%- if section.settings.guidelines != blank -%}
          <div class="sk-submit-guidelines">{{ section.settings.guidelines }}</div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Community submit",
  "tag": "section",
  "class": "sk-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "heading", "default": "Share your little one's magic", "label": "Heading" },
    { "type": "text", "id": "label_name", "default": "Child's first name", "label": "Name label" },
    { "type": "text", "id": "label_age", "default": "Child's age", "label": "Age label" },
    { "type": "text", "id": "age_placeholder", "default": "Select age", "label": "Age placeholder" },
    { "type": "text", "id": "label_email", "default": "Parent/guardian email", "label": "Email label" },
    { "type": "text", "id": "label_message", "default": "Tell us about it", "label": "Message label" },
    { "type": "text", "id": "button_label", "default": "Submit entry", "label": "Button label" },
    {
      "type": "text",
      "id": "success_message",
      "default": "Thank you — we'll be in touch about your entry.",
      "label": "Success message"
    },
    {
      "type": "richtext",
      "id": "guidelines",
      "default": "<p>By submitting, you confirm you are the parent or guardian and consent to us sharing this artwork on the Simply Kids community gallery. Artwork is shared with a first name and age only.</p>",
      "label": "Guidelines"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "presets": [{ "name": "SK Community submit" }]
}
{% endschema %}
