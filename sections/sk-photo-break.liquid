<div class="sk-photo-break" style="min-height: {{ section.settings.height }}vh;">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        loading: 'lazy',
        widths: '600, 900, 1200, 1600, 2000, 2400',
        sizes: '100vw',
        class: 'sk-photo-break__img',
        alt: section.settings.image.alt | default: section.settings.heading | escape
    }}
  {%- endif -%}

  <div class="sk-photo-break__scrim" aria-hidden="true"></div>

  <div class="sk-photo-break__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="sk-btn sk-btn--hero"
        style="margin-top: 2.4rem;"
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SK Photo break",
  "tag": "section",
  "class": "sk-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "range",
      "id": "height",
      "min": 30,
      "max": 90,
      "step": 5,
      "unit": "vh",
      "label": "Minimum height",
      "default": 50
    },
    { "type": "text", "id": "eyebrow", "default": "Why 4 to 12 matters", "label": "Eyebrow" },
    {
      "type": "text",
      "id": "heading",
      "default": "Baby care's too mild. Adult care's too harsh.",
      "label": "Heading"
    },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "SK Photo break" }]
}
{% endschema %}
