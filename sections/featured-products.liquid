{%- comment -%}
  Product grid. Pick a collection to pull live products (title, image, price,
  add-to-cart), or leave it empty and add "Product card" blocks by hand.
{%- endcomment -%}
{%- liquid
  assign coll = collections[section.settings.collection]
  assign coll_count = coll.products_count | default: 0
  assign use_collection = false
  if section.settings.collection != blank
    if coll_count > 0
      assign use_collection = true
    endif
  endif
-%}
<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="page-width" style="text-align:center;margin-bottom:2.4rem;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sk-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="sk-section__title" style="font-size: {{ section.settings.heading_font_size }}rem;">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="sk-section__text" style="opacity:.75;">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="page-width sk-grid sk-grid--{{ section.settings.columns }}">
    {%- if use_collection -%}
      {%- for product in coll.products limit: section.settings.products_to_show -%}
        {% render 'product-card',
          card_product: product,
          show_rating: section.settings.show_rating,
          rating_label: section.settings.rating_label,
          show_price: section.settings.show_price,
          tax_note: section.settings.tax_note,
          button_label: section.settings.button_label %}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {% render 'product-card',
            card_product: block.settings.product,
            image: block.settings.image,
            image_asset: block.settings.image_asset,
            title: block.settings.title,
            subtitle: block.settings.subtitle,
            price_text: block.settings.price_text,
            compare_text: block.settings.compare_text,
            badge: block.settings.badge,
            rating_count: 5,
            rating_label: block.settings.rating_label,
            show_rating: section.settings.show_rating,
            show_price: section.settings.show_price,
            tax_note: section.settings.tax_note,
            button_label: section.settings.button_label,
            button_link: block.settings.link %}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.view_all_label != blank -%}
    <div class="page-width sk-buttons sk-buttons--center" style="margin-top:3rem;">
      {% render 'button', label: section.settings.view_all_label, link: section.settings.view_all_link, style: 'outline' %}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "sk-featured-products-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Essentials"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.4,
      "max": 4.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.4
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Text",
      "default": "<p>Dermatologically tested, pH 5.5, made only for ages 4–12.</p>"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Recommended. Pulls live titles, images and prices. Leave empty to use the manual cards below."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating text for collection products",
      "default": "reviews"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Price note"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Card button label",
      "info": "Leave empty to hide. With a collection selected this adds the product to the cart."
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Top padding",
      "default": 3.6
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 2.4
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Pick a product for live data, or fill in the fields below by hand."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Built-in image file",
          "info": "Falls back to an image file shipped with the theme when no image is chosen above. Clear it to show nothing.",
          "default": "product-shampoo.jpg"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "2-in-1 Shampoo + Conditioner"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price",
          "default": "₹514"
        },
        {
          "type": "text",
          "id": "compare_text",
          "label": "Compare-at price",
          "default": "₹714"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "e.g. Save 28%"
        },
        {
          "type": "text",
          "id": "rating_label",
          "label": "Rating text",
          "default": "21 reviews"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
