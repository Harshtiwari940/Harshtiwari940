{%- liquid
  case section.settings.content_width
    when 'narrow'
      assign wrap_style = 'max-width:76rem;margin-left:auto;margin-right:auto;'
    when 'medium'
      assign wrap_style = 'max-width:100rem;margin-left:auto;margin-right:auto;'
    when 'full'
      assign wrap_style = 'max-width:none;'
    else
      assign wrap_style = ''
  endcase
-%}
<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="page-width sk-section__header sk-section__header--center" style="margin-bottom: {{ section.settings.header_gap }}rem;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sk-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sk-section__title" style="font-size: {{ section.settings.heading_font_size }}rem;">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="sk-section__text" style="opacity:.8;">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="page-width sk-grid sk-grid--{{ section.settings.columns }}" style="{{ wrap_style }}">
    {%- for block in section.blocks -%}
      <div
        class="sk-tool-card"
        {{ block.shopify_attributes }}
        style="
          text-align: {{ section.settings.card_align }};
          {% if block.settings.image != blank or block.settings.image_asset != blank %}padding:0;overflow:hidden;{% endif %}
          {% if block.settings.background != blank %}background: {{ block.settings.background }};{% endif %}
        "
      >
        {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
          {%- assign card_img_style = 'width:100%;height:auto;display:block;aspect-ratio:' | append: section.settings.image_ratio | append: ';object-fit:cover;' -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="display:block;">{%- endif -%}
            {% render 'image-or-asset',
              image: block.settings.image,
              asset: block.settings.image_asset,
              alt: block.settings.heading,
              img_style: card_img_style %}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        {%- endif -%}

        <div {% if block.settings.image != blank or block.settings.image_asset != blank %}style="padding:2rem;"{% endif %}>
          {%- if block.settings.icon != 'none' and block.settings.image == blank and block.settings.image_asset == blank -%}
            <div style="margin-bottom:1rem;{% if section.settings.card_align == 'center' %}display:flex;justify-content:center;{% endif %}">
              {% render 'icon', name: block.settings.icon, size: 36 %}
            </div>
          {%- endif -%}

          {%- if block.settings.badge != blank -%}
            <span class="sk-eyebrow">{{ block.settings.badge }}</span>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 style="font-size: {{ section.settings.card_heading_size }}rem;{% if block.settings.heading_color != blank %}color:{{ block.settings.heading_color }};{% endif %}">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" style="color:inherit;text-decoration:none;">{{ block.settings.heading }}</a>
              {%- else -%}
                {{ block.settings.heading }}
              {%- endif -%}
            </h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div style="opacity:.85;font-size: {{ section.settings.card_text_size }}rem;">{{ block.settings.text }}</div>
          {%- endif -%}

          {%- if block.settings.footnote != blank -%}
            <p style="font-weight:700;color:var(--sk-blue-deep);margin-bottom:0;">{{ block.settings.footnote }}</p>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <div style="margin-top:1rem;">
              {% render 'button', label: block.settings.button_label, link: block.settings.button_link, style: block.settings.button_style, full: section.settings.full_width_buttons %}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.button_label != blank -%}
    <div class="page-width sk-buttons sk-buttons--center" style="margin-top:3rem;">
      {% render 'button', label: section.settings.button_label, link: section.settings.button_link, style: section.settings.button_style %}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Card grid",
  "tag": "section",
  "class": "sk-card-grid-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Promise"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.4,
      "max": 4.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.6
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Text under heading"
    },
    {
      "type": "range",
      "id": "header_gap",
      "min": 0,
      "max": 8,
      "step": 0.5,
      "unit": "rem",
      "label": "Space below heading",
      "default": 3.0
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "card_align",
      "label": "Card text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "card_heading_size",
      "min": 1.2,
      "max": 3.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Card heading size",
      "default": 1.7
    },
    {
      "type": "range",
      "id": "card_text_size",
      "min": 1.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Card text size",
      "default": 1.4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Card image shape",
      "options": [
        {
          "value": "16/10",
          "label": "Landscape"
        },
        {
          "value": "1/1",
          "label": "Square"
        },
        {
          "value": "4/5",
          "label": "Portrait"
        },
        {
          "value": "auto",
          "label": "Original"
        }
      ],
      "default": "16/10"
    },
    {
      "type": "checkbox",
      "id": "full_width_buttons",
      "label": "Full-width card buttons",
      "default": false
    },
    {
      "type": "header",
      "content": "Section button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "hero",
          "label": "Hero"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "outline"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "3"
