{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div style="max-width: {{ section.settings.max_width }}rem; margin: 0 auto;">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="sk-section-head" style="margin-bottom: 2.4rem;">
          {%- if section.settings.eyebrow != blank -%}
            <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            {%- if section.settings.heading_tag == 'h1' -%}
              <h1 style="font-size: 2.8rem; margin: 0;">{{ section.settings.heading | escape }}</h1>
            {%- else -%}
              <h2>{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="sk-accordion">
        {%- for block in section.blocks -%}
          <details {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.question | escape }}</span>
              <span class="sk-accordion__icon svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <div class="sk-accordion__body">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  FAQPage structured data is generated from the same blocks the page renders,
  so the markup and the schema can never drift apart.
{%- endcomment -%}
{%- if section.settings.enable_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "SK FAQ",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 30,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "default": "Frequently asked questions", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        { "value": "h1", "label": "H1 — page title" },
        { "value": "h2", "label": "H2 — section title" }
      ],
      "default": "h2",
      "label": "Heading level"
    },
    { "type": "checkbox", "id": "open_first", "default": false, "label": "Open the first question" },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "default": true,
      "label": "Add FAQ structured data",
      "info": "Lets Google show these questions as rich results. Use on one section per page."
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 50,
      "max": 124,
      "step": 2,
      "unit": "rem",
      "label": "Content width",
      "default": 76
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "default": "Is this safe for sensitive skin?", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
