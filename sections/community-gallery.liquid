<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="sk-section__title" style="text-align:center;font-size: {{ section.settings.heading_font_size }}rem;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="sk-gallery-grid">
      {%- for block in section.blocks -%}
        <div
          class="sk-gallery-card color-scheme-{{ block.settings.color_scheme }}"
          {{ block.shopify_attributes }}
          style="{% if block.settings.image != blank %}padding:0;{% endif %}"
        >
          {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
            {% render 'image-or-asset',
              image: block.settings.image,
              asset: block.settings.image_asset,
              alt: block.settings.name,
              widths: '200,300,400,600,800',
              img_style: 'width:100%;height:100%;object-fit:cover;position:absolute;inset:0;' %}
          {%- endif -%}
          {%- if block.settings.name != blank -%}
            <div class="sk-gallery-card__name">{{ block.settings.name }}</div>
          {%- endif -%}
          {%- if block.settings.age != blank -%}
            <div class="sk-gallery-card__age">{{ block.settings.age }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

