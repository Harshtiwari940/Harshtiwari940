<div
  class="sk-community-hero color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sk-eyebrow" style="color:{{ section.settings.accent_color }};">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} style="font-size: {{ section.settings.heading_font_size }}rem;">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          &nbsp;<span style="color:{{ section.settings.accent_color }};font-style:italic;font-family:var(--font-script);font-weight:700;">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="sk-section__text" style="max-width:56rem;margin:1rem auto 0;opacity:.85;">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sk-community-stats">
        {%- for block in section.blocks -%}
          <span class="sk-pill sk-pill--trust" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Community hero",
  "tag": "section",
  "class": "sk-community-hero-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "A humble abode"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pride of"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading in script font",
      "default": "Simply Kids"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.8,
      "max": 5.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.8
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Welcome to every child's brighter corner — where colourful drawings, joyful laughter, and the moments that make us stop and smile are celebrated.</p>"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#FBC4DE"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "13"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Top padding",
      "default": 5.0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 5.0
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "247 young creators"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community hero",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "label": "247 young creators"
          }
        },
        {
          "type": "stat",
          "settings": {
            "label": "609 artworks shared"
          }
        },
        {
          "type": "stat",
          "settings": {
            "label": "429 families"
          }
        }
      ]
    }
  ]
}
{% endschema %}
