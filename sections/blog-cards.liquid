{%- comment -%}
  Article grid. Pick a blog to pull live articles, or add "Article card"
  blocks by hand.
{%- endcomment -%}
{%- liquid
  assign feed = blogs[section.settings.blog]
  assign feed_count = feed.articles_count | default: 0
  assign use_blog = false
  if section.settings.blog != blank
    if feed_count > 0
      assign use_blog = true
    endif
  endif
-%}
<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.view_all_label != blank -%}
    <div
      class="page-width"
      style="
        display:flex;justify-content:space-between;align-items:flex-end;
        margin-bottom:3rem;flex-wrap:wrap;gap:1rem;
        {% if section.settings.center_heading %}justify-content:center;text-align:center;flex-direction:column;align-items:center;{% endif %}
      "
    >
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="sk-section__title" style="font-size: {{ section.settings.heading_font_size }}rem;margin:0;">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="sk-section__text" style="opacity:.8;margin-top:1rem;">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      {% render 'button', label: section.settings.view_all_label, link: section.settings.view_all_link, style: 'outline' %}
    </div>
  {%- endif -%}

  <div class="page-width sk-grid sk-grid--{{ section.settings.columns }}">
    {%- if use_blog -%}
      {%- for article in feed.articles limit: section.settings.articles_to_show -%}
        <div class="sk-tool-card" style="padding:0;overflow:hidden;">
          <a href="{{ article.url }}" style="display:block;">
            {%- if article.image -%}
              {{ article.image | image_url: width: 1200 | image_tag:
                loading: 'lazy',
                widths: '300,450,600,900,1200',
                alt: article.title,
                style: 'width:100%;height:auto;display:block;aspect-ratio:16/10;object-fit:cover;' }}
            {%- else -%}
              <div style="aspect-ratio:16/10;background:var(--sk-blue-wash);display:flex;align-items:center;justify-content:center;color:var(--sk-blue-deep);font-family:var(--font-label);font-weight:700;">
                {{ section.settings.image_placeholder }}
              </div>
            {%- endif -%}
          </a>
          <div style="padding:2rem;">
            <h3 style="font-size: {{ section.settings.card_heading_size }}rem;">
              <a href="{{ article.url }}" style="color:inherit;text-decoration:none;">{{ article.title }}</a>
            </h3>
            {%- if section.settings.show_date -%}
              <div style="opacity:.6;font-size:1.2rem;margin-bottom:.6rem;">{{ article.published_at | date: format: 'date' }}</div>
            {%- endif -%}
            {%- if section.settings.show_excerpt -%}
              <p style="opacity:.7;font-size: {{ section.settings.card_text_size }}rem;">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        <div class="sk-tool-card" style="padding:0;overflow:hidden;" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="display:block;">{%- endif -%}
            {% render 'image-or-asset',
              image: block.settings.image,
              asset: block.settings.image_asset,
              alt: block.settings.heading,
              img_style: 'width:100%;height:auto;display:block;aspect-ratio:16/10;object-fit:cover;',
              placeholder: section.settings.image_placeholder,
              ratio: '16/10' %}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
          <div style="padding:2rem;">
            {%- if block.settings.heading != blank -%}
              <h3 style="font-size: {{ section.settings.card_heading_size }}rem;">
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" style="color:inherit;text-decoration:none;">{{ block.settings.heading }}</a>
                {%- else -%}
                  {{ block.settings.heading }}
                {%- endif -%}
              </h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p style="opacity:.7;font-size: {{ section.settings.card_text_size }}rem;">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Article cards",
  "tag": "section",
  "class": "sk-blog-cards-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "From the Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real answers for the 4–12 years."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.4,
      "max": 4.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.4
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text under heading"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Center the heading",
      "default": false
    },
    {
      "type": "header",
      "content": "Articles"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Recommended. Pulls live articles. Leave empty to use the manual cards below."
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Articles to show",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": false
    },
    {
      "type": "text",
      "id": "image_placeholder",
      "label": "Placeholder text when an article has no image",
      "default": "Article photo"
    },
    {
      "type": "range",
      "id": "card_heading_size",
      "min": 1.2,
      "max": 2.6,
      "step": 0.1,
      "unit": "rem",
      "label": "Card heading size",
      "default": 1.6
    },
    {
      "type": "range",
      "id": "card_text_size",
      "min": 1.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Card text size",
      "default": 1.3
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Label",
      "default": "View all articles"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Top padding",
      "default": 6.0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 6.0
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Built-in image file",
          "info": "Falls back to an image file shipped with the theme when no image is chosen above. Clear it to show nothing.",
          "default": ""
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "default": "Why 4–12 is a real, distinct life stage for skin and hair"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Excerpt",
          "default": "The science behind why this age group needs its own formulas."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article cards",
      "blocks": [
        {
          "type": "article"
        },
        {
          "type": "article"
        },
        {
          "type": "article"
        }
      ]
    }
  ]
}
{% endschema %}
