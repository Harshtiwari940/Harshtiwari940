<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  <div class="page-width">
    <div style="text-align:center;margin-bottom:3rem;">
      <h1 class="sk-section__title" style="font-size: {{ section.settings.heading_font_size }}rem;">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="sk-section__text" style="opacity:.8;">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="sk-grid sk-grid--{{ section.settings.columns }}">
      {%- for coll in collections -%}
        <div class="sk-tool-card" style="padding:0;overflow:hidden;">
          <a href="{{ coll.url }}" style="display:block;">
            {%- if coll.featured_image -%}
              {{ coll.featured_image | image_url: width: 1000 | image_tag:
                loading: 'lazy',
                widths: '300,450,600,800,1000',
                alt: coll.title,
                style: 'width:100%;height:auto;display:block;aspect-ratio:1/1;object-fit:cover;' }}
            {%- else -%}
              <div style="aspect-ratio:1/1;background:var(--sk-blue-wash);"></div>
            {%- endif -%}
          </a>
          <div style="padding:1.6rem;">
            <h3 style="font-size:1.6rem;margin:0;">
              <a href="{{ coll.url }}" style="color:inherit;text-decoration:none;">{{ coll.title }}</a>
            </h3>
            {%- if section.settings.show_count -%}
              <div style="opacity:.6;font-size:1.2rem;">{{ coll.products_count }} products</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "class": "sk-list-collections-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.6,
      "max": 4.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.6
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Top padding",
      "default": 4.0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 5.0
    }
  ],
  "presets": [
    {
      "name": "Collections list"
    }
  ]
}
{% endschema %}
