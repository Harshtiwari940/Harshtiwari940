{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="sk-section-head" style="margin-bottom: 2.4rem;">
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="sk-gallery-grid">
      {%- for block in section.blocks -%}
        <div
          class="sk-gallery-card color-{{ block.settings.color_scheme }} gradient"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '300, 400, 600, 800',
                sizes: '(min-width: 990px) 25vw, 50vw',
                class: 'sk-gallery-card__img',
                alt: block.settings.name | escape
            }}
          {%- endif -%}
          {%- if block.settings.name != blank -%}
            <div class="sk-gallery-card__name">{{ block.settings.name | escape }}</div>
          {%- endif -%}
          {%- if block.settings.age != blank -%}
            <div class="sk-gallery-card__age">{{ block.settings.age | escape }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Community gallery",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "heading", "default": "Meet our young creators", "label": "Heading" },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "creator",
      "name": "Creator",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Artwork" },
        { "type": "text", "id": "name", "default": "Anagha", "label": "First name" },
        { "type": "text", "id": "age", "default": "Age 8", "label": "Age" },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Community gallery",
      "blocks": [{ "type": "creator" }, { "type": "creator" }, { "type": "creator" }, { "type": "creator" }]
    }
  ]
}
{% endschema %}
