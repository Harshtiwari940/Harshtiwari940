{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <div class="page-width sk-section-head" style="margin-bottom: 3rem;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="sk-card-grid sk-card-grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="sk-tool-card sk-review-card" {{ block.shopify_attributes }}>
          <div class="sk-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..block.settings.rating) -%}&#9733;{%- endfor -%}
          </div>
          {%- if block.settings.quote != blank -%}
            <p>&ldquo;{{ block.settings.quote | escape }}&rdquo;</p>
          {%- endif -%}
          {%- if block.settings.name != blank -%}
            <strong class="sk-review-card__name">{{ block.settings.name | escape }}</strong>
          {%- endif -%}
          {%- if block.settings.meta != blank -%}
            <div class="sk-review-card__meta">{{ block.settings.meta | escape }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Reviews",
  "tag": "section",
  "class": "sk-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-8"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "default": "Care parents talk about", "label": "Heading" },
    {
      "type": "select",
      "id": "columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3",
      "label": "Columns"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "meta", "label": "Meta", "info": "For example: Mom of 8 y.o., Kolkata" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Reviews",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
