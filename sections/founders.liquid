{%- liquid
  case section.settings.content_width
    when 'narrow'
      assign wrap_style = 'max-width:76rem;margin-left:auto;margin-right:auto;'
    when 'medium'
      assign wrap_style = 'max-width:100rem;margin-left:auto;margin-right:auto;'
    when 'full'
      assign wrap_style = 'max-width:none;'
    else
      assign wrap_style = ''
  endcase
-%}
<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  <div class="page-width" style="{{ wrap_style }}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div style="text-align:center;margin-bottom:3rem;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sk-section__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div class="sk-story-gen" {{ block.shopify_attributes }}>
        <div class="sk-story-gen__badge">
          {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
            {% render 'image-or-asset',
              image: block.settings.image,
              asset: block.settings.image_asset,
              alt: block.settings.name,
              widths: '100,200',
              img_style: 'width:100%;height:100%;object-fit:cover;border-radius:50%;' %}
          {%- else -%}
            {{ block.settings.badge | default: forloop.index }}
          {%- endif -%}
        </div>
        <div>
          {%- if block.settings.name != blank -%}
            <h4 class="sk-story-gen__name">{{ block.settings.name }}</h4>
          {%- endif -%}
          {%- if block.settings.role != blank -%}
            <span class="sk-story-gen__role">{{ block.settings.role }}</span>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="sk-section__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "People",
  "tag": "section",
  "class": "sk-founders-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Meet Our Founders"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Top padding",
      "default": 6.0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 6.0
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Optional. Replaces the numbered badge."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Built-in image file",
          "info": "Falls back to an image file shipped with the theme when no image is chosen above. Clear it to show nothing.",
          "default": ""
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "info": "Defaults to the position in the list."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Pratibha Gupta"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "M.Sc. Botanical Sciences, Medical Plants Expert — “The Brain”"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Bio",
          "default": "<p>A visionary in medicinal plants and sustainability, she brings over 20 years of expertise to every formulation — guiding the R&amp;D team with wisdom, purpose, and a deep passion for conscious care.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "People",
      "blocks": [
        {
          "type": "person"
        },
        {
          "type": "person"
        },
        {
          "type": "person"
        }
      ]
    }
  ]
}
{% endschema %}
