{%- comment -%}
  Tabbed routines. Each tab is a block; the "moments" inside it are one per
  line. Works with no JavaScript using hidden radios + sibling selectors.
{%- endcomment -%}
<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div style="text-align:center;margin-bottom:2rem;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sk-section__title" style="font-size: {{ section.settings.heading_font_size }}rem;">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sk-routine" id="Routine-{{ section.id }}">
      {%- for block in section.blocks -%}
        <input
          class="sk-routine__radio sk-visually-hidden"
          type="radio"
          name="Routine-{{ section.id }}"
          id="Routine-{{ section.id }}-{{ forloop.index }}"
          {% if forloop.first %}checked{% endif %}
        >
      {%- endfor -%}

      <div class="sk-routine-tabs">
        {%- for block in section.blocks -%}
          <label
            class="sk-routine-tab sk-routine-tab--{{ forloop.index }}"
            for="Routine-{{ section.id }}-{{ forloop.index }}"
            {{ block.shopify_attributes }}
          >{{ block.settings.tab_label }}</label>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="sk-routine-panel sk-routine-panel--{{ forloop.index }}">
          {%- assign rows = block.settings.moments | newline_to_br | split: '<br />' -%}
          {%- for row in rows -%}
            {%- assign parts = row | strip | split: '|' -%}
            {%- if parts[0] != blank -%}
              <div class="sk-routine-moment">
                <div class="sk-routine-moment__time">{{ parts[0] | strip }}</div>
                <div>{{ parts[1] | strip }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
          {% render 'button', label: block.settings.button_label, link: block.settings.button_link, style: block.settings.button_style %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #Routine-{{ section.id }} .sk-routine-tab { cursor: pointer; }
  #Routine-{{ section.id }} .sk-routine-panel { display: none; }
  {%- for block in section.blocks -%}
    {%- assign n = forloop.index -%}
    #Routine-{{ section.id }} .sk-routine__radio:nth-of-type({{ n }}):checked ~ .sk-routine-panel--{{ n }} { display: block; }
    #Routine-{{ section.id }} .sk-routine__radio:nth-of-type({{ n }}):checked ~ .sk-routine-tabs .sk-routine-tab--{{ n }} {
      background: var(--sk-blue-deep);
      color: #fff;
      border-color: var(--sk-blue-deep);
    }
    #Routine-{{ section.id }} .sk-routine__radio:nth-of-type({{ n }}):focus-visible ~ .sk-routine-tabs .sk-routine-tab--{{ n }} {
      outline: 2px solid var(--sk-blue-vivid);
      outline-offset: 2px;
    }
  {%- endfor -%}
</style>

{% schema %}
{
  "name": "Routine tabs",
  "tag": "section",
  "class": "sk-routine-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Ready-made routines"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three moments, that's the whole routine"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.4,
      "max": 4.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.2
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Top padding",
      "default": 3.0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 3.0
    }
  ],
  "blocks": [
    {
      "type": "routine",
      "name": "Routine tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Ages 4–6 · Little Explorers"
        },
        {
          "type": "textarea",
          "id": "moments",
          "label": "Moments",
          "info": "One per line as: time | what to do.",
          "default": "Morning | A quick rinse with the Gentle Body Wash — fast enough that it doesn't turn into a wrestling match.\nBath time | 2-in-1 Shampoo + Conditioner so wash day stops being a fight over tangles.\nBedtime | A little Nourishing Body Massage Oil worked in while you read one more story."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop this routine"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "hero",
              "label": "Hero"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine tabs",
      "blocks": [
        {
          "type": "routine",
          "settings": {
            "tab_label": "Ages 4–6 · Little Explorers"
          }
        },
        {
          "type": "routine",
          "settings": {
            "tab_label": "Ages 7–9 · Big Kids"
          }
        },
        {
          "type": "routine",
          "settings": {
            "tab_label": "Ages 10–12 · Tweens"
          }
        }
      ]
    }
  ]
}
{% endschema %}
