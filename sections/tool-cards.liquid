{%- comment -%}
  Small interactive-feeling cards (a tip of the day, a drawing prompt).
  Each card is a block with its own output text and button.
{%- endcomment -%}
<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="sk-section__title" style="text-align:center;font-size: {{ section.settings.heading_font_size }}rem;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="sk-grid sk-grid--{{ section.settings.columns }}" style="max-width:80rem;margin:1.6rem auto 0;">
      {%- for block in section.blocks -%}
        <div class="sk-tool-card" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="sk-section__text" style="opacity:.8;font-size:1.3rem;">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.output != blank -%}
            <div class="sk-spark-output">{{ block.settings.output }}</div>
          {%- endif -%}
          {% render 'button', label: block.settings.button_label, link: block.settings.button_link, style: block.settings.button_style, full: true %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tool cards",
  "tag": "section",
  "class": "sk-tool-cards-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two little things to play with"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.4,
      "max": 3.4,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 1.6
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on desktop",
      "default": 2
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Top padding",
      "default": 3.6
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 3.6
    }
  ],
  "blocks": [
    {
      "type": "tool",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "What should I draw today?"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "textarea",
          "id": "output",
          "label": "Highlighted output",
          "default": "Draw your favourite animal wearing a superhero cape."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Give me an idea"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "hero",
              "label": "Hero"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tool cards",
      "blocks": [
        {
          "type": "tool"
        },
        {
          "type": "tool"
        }
      ]
    }
  ]
}
{% endschema %}
