{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-community-hero sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="sk-community-hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="sk-community-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sk-community-stats">
        {%- for block in section.blocks -%}
          <span class="sk-pill sk-pill--trust" {{ block.shopify_attributes }}>
            {{- block.settings.text | escape -}}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SK Community hero",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-13"
    },
    { "type": "text", "id": "eyebrow", "default": "A humble abode", "label": "Eyebrow" },
    {
      "type": "richtext",
      "id": "heading",
      "default": "<p>Pride of <em>Simply Kids</em></p>",
      "label": "Heading",
      "info": "Text inside <em> renders in the Dancing Script accent."
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [{ "type": "text", "id": "text", "default": "247 young creators", "label": "Text" }]
    }
  ],
  "presets": [
    {
      "name": "SK Community hero",
      "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }]
    }
  ]
}
{% endschema %}
