{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="sk-section-head" style="margin-bottom: 2.4rem;">
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="sk-card-grid sk-card-grid--2" style="max-width: 80rem; margin: 0 auto;">
      {%- comment -%} Tool 1 — date of birth to age-stage care tip {%- endcomment -%}
      <sk-dob-tip
        class="sk-tool-card"
        data-empty-message="{{ section.settings.dob_empty | escape }}"
        data-out-of-range-message="{{ section.settings.dob_out_of_range | escape }}"
      >
        <h3>{{ section.settings.dob_heading | escape }}</h3>
        <label class="visually-hidden" for="SkDob-{{ section.id }}">
          {{- section.settings.dob_heading | escape -}}
        </label>
        <input
          type="date"
          id="SkDob-{{ section.id }}"
          class="sk-field sk-field--round"
          style="margin: 0.6rem 0;"
        >
        <div class="sk-spark-output"></div>
        <button type="button" class="sk-btn sk-btn--primary sk-btn--full">
          {{- section.settings.dob_button | escape -}}
        </button>
        <script type="application/json">
          [
            {%- for block in section.blocks -%}
              {%- if block.type == 'tip' -%}
                {
                  "min": {{ block.settings.age_min | json }},
                  "max": {{ block.settings.age_max | json }},
                  "text": {{ block.settings.text | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endif -%}
            {%- endfor -%}
          ]
        </script>
      </sk-dob-tip>

      {%- comment -%} Tool 2 — random drawing prompt {%- endcomment -%}
      <sk-creativity-spark class="sk-tool-card">
        <h3>{{ section.settings.spark_heading | escape }}</h3>
        <div class="sk-spark-output">{{ section.settings.spark_default | escape }}</div>
        <button type="button" class="sk-btn sk-btn--primary sk-btn--full">
          {{- section.settings.spark_button | escape -}}
        </button>
        <script type="application/json">
          {{ section.settings.spark_ideas | newline_to_br | split: '<br />' | json }}
        </script>
      </sk-creativity-spark>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Community tools",
  "tag": "section",
  "class": "sk-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "heading", "default": "Two little things to play with", "label": "Heading" },
    {
      "type": "header",
      "content": "Care tip finder"
    },
    {
      "type": "text",
      "id": "dob_heading",
      "default": "What does their skin need today?",
      "label": "Heading"
    },
    { "type": "text", "id": "dob_button", "default": "Show my tip", "label": "Button label" },
    {
      "type": "text",
      "id": "dob_empty",
      "default": "Pick a date of birth first.",
      "label": "Empty message"
    },
    {
      "type": "text",
      "id": "dob_out_of_range",
      "default": "Simply Kids is formulated for ages 4 to 12.",
      "label": "Out-of-range message"
    },
    {
      "type": "header",
      "content": "Creativity spark"
    },
    {
      "type": "text",
      "id": "spark_heading",
      "default": "What should I draw today?",
      "label": "Heading"
    },
    { "type": "text", "id": "spark_button", "default": "Give me an idea", "label": "Button label" },
    {
      "type": "text",
      "id": "spark_default",
      "default": "Draw your favourite animal wearing a superhero cape.",
      "label": "Starting idea"
    },
    {
      "type": "textarea",
      "id": "spark_ideas",
      "default": "Draw your favourite animal wearing a superhero cape.\nDraw the view from your bedroom window, but on another planet.\nDraw a machine that makes bath time more fun.\nDraw your family as a team of explorers.\nDraw the silliest hairstyle you can imagine.\nDraw a garden where every plant is a different colour.",
      "label": "Ideas",
      "info": "One per line."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "tip",
      "name": "Care tip",
      "settings": [
        { "type": "number", "id": "age_min", "default": 4, "label": "Youngest age" },
        { "type": "number", "id": "age_max", "default": 6, "label": "Oldest age" },
        { "type": "textarea", "id": "text", "label": "Tip" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Community tools",
      "blocks": [{ "type": "tip" }, { "type": "tip" }, { "type": "tip" }]
    }
  ]
}
{% endschema %}
