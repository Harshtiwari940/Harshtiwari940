{%- render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="sk-page-hero sk-pad-{{ section.id }} color-{{ section.settings.color_scheme }} gradient{% if section.settings.alignment == 'left' %} sk-page-hero--left{% endif %}">
  <div class="page-width">
    <div class="sk-page-hero__inner" style="max-width: {{ section.settings.max_width }}rem;">
      {%- if section.settings.show_breadcrumb -%}
        <p class="sk-page-hero__crumb" style="opacity: 0.6; font-size: 1.3rem;">
          <a href="{{ routes.root_url }}" style="text-decoration: none;">Home</a>
          {%- if page.title != blank %} / {{ page.title | escape }}{% endif -%}
        </p>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="sk-page-hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="sk-page-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="sk-page-hero__actions">
          <a href="{{ section.settings.button_link | default: '#' }}" class="sk-btn sk-btn--primary">
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK Page hero",
  "tag": "section",
  "class": "sk-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        { "value": "center", "label": "Centered" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center",
      "label": "Alignment"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "default": false,
      "label": "Show breadcrumb"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "<p>Page title</p>",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 40,
      "max": 110,
      "step": 2,
      "unit": "rem",
      "label": "Content width",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "presets": [{ "name": "SK Page hero" }]
}
{% endschema %}
