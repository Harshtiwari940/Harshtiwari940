<div
  class="color-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"
>
  <div class="page-width">
    {%- if section.settings.show_title -%}
      <div style="text-align:center;margin-bottom:3rem;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="sk-section__title" style="font-size: {{ section.settings.heading_font_size }}rem;">
          {{ section.settings.heading | default: blog.title }}
        </h1>
        {%- if section.settings.text != blank -%}
          <div class="sk-section__text" style="opacity:.8;max-width:70rem;margin:0 auto;">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      <div class="sk-grid sk-grid--{{ section.settings.columns }}">
        {%- for article in blog.articles -%}
          <div class="sk-tool-card" style="padding:0;overflow:hidden;">
            <a href="{{ article.url }}" style="display:block;">
              {%- if article.image -%}
                {{ article.image | image_url: width: 1200 | image_tag:
                  loading: 'lazy',
                  widths: '300,450,600,900,1200',
                  alt: article.title,
                  style: 'width:100%;height:auto;display:block;aspect-ratio:16/10;object-fit:cover;' }}
              {%- else -%}
                <div style="aspect-ratio:16/10;background:var(--sk-blue-wash);display:flex;align-items:center;justify-content:center;color:var(--sk-blue-deep);font-family:var(--font-label);font-weight:700;">
                  {{ section.settings.image_placeholder }}
                </div>
              {%- endif -%}
            </a>
            <div style="padding:2rem;">
              <h3 style="font-size:1.6rem;">
                <a href="{{ article.url }}" style="color:inherit;text-decoration:none;">{{ article.title }}</a>
              </h3>
              {%- if section.settings.show_date -%}
                <div style="opacity:.6;font-size:1.2rem;margin-bottom:.6rem;">{{ article.published_at | date: format: 'date' }}</div>
              {%- endif -%}
              {%- if section.settings.show_excerpt -%}
                <p style="opacity:.7;font-size:1.3rem;">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav style="display:flex;gap:1rem;justify-content:center;margin-top:3rem;flex-wrap:wrap;align-items:center;">
          {%- if paginate.previous -%}<a class="sk-btn sk-btn--outline" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" style="padding:.7rem 1.2rem;font-family:var(--font-label);">{{ part.title }}</a>
            {%- else -%}
              <span style="padding:.7rem 1.2rem;font-family:var(--font-label);font-weight:800;">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a class="sk-btn sk-btn--outline" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "sk-main-blog-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the blog title."
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 1.6,
      "max": 4.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size",
      "default": 2.8
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Skincare science, routines, and honest parenting notes — written for the age group everyone else skips.</p>"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Articles per page",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": false
    },
    {
      "type": "text",
      "id": "image_placeholder",
      "label": "Placeholder text",
      "default": "Article photo"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "1",
          "label": "1 — White"
        },
        {
          "value": "2",
          "label": "2 — White"
        },
        {
          "value": "3",
          "label": "3 — Pale blue fade"
        },
        {
          "value": "4",
          "label": "4 — Pale blue"
        },
        {
          "value": "5",
          "label": "5 — Blue gradient (light text)"
        },
        {
          "value": "6",
          "label": "6 — Deep blue (light text)"
        },
        {
          "value": "7",
          "label": "7 — Blue wash fade"
        },
        {
          "value": "8",
          "label": "8 — Blue fade"
        },
        {
          "value": "9",
          "label": "9 — Blue wash to white"
        },
        {
          "value": "10",
          "label": "10 — Deep blue (light text)"
        },
        {
          "value": "11",
          "label": "11 — Pink gradient"
        },
        {
          "value": "12",
          "label": "12 — Pink fade"
        },
        {
          "value": "13",
          "label": "13 — Blue (light text)"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Top padding",
      "default": 5.0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Bottom padding",
      "default": 5.0
    }
  ],
  "presets": [
    {
      "name": "Blog posts"
    }
  ]
}
{% endschema %}
