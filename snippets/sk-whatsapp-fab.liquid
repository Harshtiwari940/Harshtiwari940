{% comment %}
  Floating WhatsApp button. Renders only when a number is set in
  Theme settings → Simply Kids. The green is WhatsApp's own brand colour,
  deliberately outside the Simply Kids palette because it is a utility icon.
{% endcomment %}

{%- liquid
  assign number = settings.whatsapp_number | remove: ' ' | remove: '-' | remove: '+' | remove: '(' | remove: ')'
-%}

{%- if number != blank -%}
  <a
    class="sk-whatsapp-fab"
    href="https://wa.me/{{ number }}{% if settings.whatsapp_message != blank %}?text={{ settings.whatsapp_message | url_encode }}{% endif %}"
    target="_blank"
    rel="noopener"
    aria-label="{{ settings.whatsapp_label | default: 'Chat with us on WhatsApp' | escape }}"
  >
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path d="M16.001 3C9.096 3 3.5 8.596 3.5 15.5c0 2.36.655 4.566 1.792 6.452L3 29l7.222-2.254A12.44 12.44 0 0 0 16 28c6.905 0 12.5-5.596 12.5-12.5S22.906 3 16.001 3zm0 22.5c-1.93 0-3.73-.54-5.262-1.475l-.377-.223-3.905 1.219 1.236-3.81-.245-.39A9.936 9.936 0 0 1 6 15.5c0-5.514 4.486-10 10.001-10 5.514 0 10 4.486 10 10s-4.486 10-10 10zm5.49-7.47c-.3-.15-1.771-.874-2.046-.974-.274-.1-.474-.15-.674.15-.2.3-.773.974-.948 1.174-.175.2-.35.225-.649.075-.3-.15-1.264-.466-2.408-1.486-.89-.794-1.49-1.774-1.665-2.074-.175-.3-.019-.462.131-.611.135-.134.3-.35.45-.524.15-.175.2-.3.3-.5.1-.2.05-.375-.025-.525-.075-.15-.674-1.625-.923-2.225-.243-.584-.49-.505-.674-.514l-.574-.01c-.2 0-.524.075-.799.375s-1.048 1.024-1.048 2.499 1.073 2.899 1.223 3.099c.15.2 2.112 3.225 5.117 4.522.715.309 1.273.493 1.708.631.718.228 1.371.196 1.887.119.576-.086 1.771-.724 2.021-1.424.25-.7.25-1.3.175-1.424-.075-.125-.275-.2-.575-.35z"/>
    </svg>
  </a>
{%- endif -%}
