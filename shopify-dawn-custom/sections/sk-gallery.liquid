{%- comment -%}
  Simply Kids — community gallery

  From v19-community. Four hardcoded cards with a name and an age become
  image-backed blocks with a stat row above them.

  Used by: page.our-community-2.json
{%- endcomment -%}

{% render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
%}

{%- assign entries = section.blocks | where: 'type', 'entry' -%}
{%- assign stats = section.blocks | where: 'type', 'stat' -%}

<div class="sk-section color-{{ section.settings.color_scheme }} gradient sk-section-{{ section.id }}">
  <div class="sk-section__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="sk-section__head sk-section__head--center">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sk-section__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="sk-section__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if stats.size > 0 -%}
          <div class="sk-stats-row">
            {%- for block in stats -%}
              <span class="sk-pill sk-pill--trust" {{ block.shopify_attributes }}>
                {{- block.settings.text | escape -}}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if entries.size > 0 -%}
      <div class="sk-grid sk-grid--4">
        {%- for block in entries -%}
          <figure class="sk-gallery__card" style="margin: 0;" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 300, 400, 600',
                  sizes: '(min-width: 990px) 22vw, 45vw',
                  alt: block.settings.name
              }}
            {%- endif -%}

            {%- if block.settings.name != blank or block.settings.age != blank -%}
              <figcaption class="sk-gallery__meta">
                {%- if block.settings.name != blank -%}
                  <span class="sk-gallery__name">{{ block.settings.name | escape }}</span>
                {%- endif -%}
                {%- if block.settings.age != blank -%}
                  <span class="sk-gallery__age">{{ block.settings.age | escape }}</span>
                {%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="sk-section__head--center" style="margin-top: 3.2rem;">
        <a
          class="sk-btn sk-btn--primary"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            href="#"
            aria-disabled="true"
          {% endif %}
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SK · Community gallery",
  "tag": "section",
  "class": "sk-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Be the pride" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our community" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label" },
    { "type": "url", "id": "button_link", "label": "Link" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range", "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top", "default": 56
    },
    {
      "type": "range", "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom", "default": 56
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat pill",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "12,000 families" }
      ]
    },
    {
      "type": "entry",
      "name": "Gallery entry",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Aanya" },
        { "type": "text", "id": "age", "label": "Age", "default": "Age 7" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK · Community gallery",
      "blocks": [
        { "type": "stat" },
        { "type": "entry" },
        { "type": "entry" },
        { "type": "entry" },
        { "type": "entry" }
      ]
    }
  ]
}
{% endschema %}
