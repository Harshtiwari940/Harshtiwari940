{%- comment -%}
  Simply Kids — timeline

  The founder-story "three generations" list from v19-story, where each entry
  was hardcoded markup. Entries are blocks now, so a fourth can be added
  without a developer.

  Used by: page.about-us.json
{%- endcomment -%}

{% render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
%}

<div class="sk-section color-{{ section.settings.color_scheme }} gradient sk-section-{{ section.id }}">
  <div class="sk-section__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="sk-section__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sk-section__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sk-timeline" style="max-width: 82rem;">
      {%- for block in section.blocks -%}
        <div class="sk-timeline__entry" {{ block.shopify_attributes }}>
          <span class="sk-timeline__badge" aria-hidden="true">
            {{- block.settings.badge | escape -}}
          </span>

          <div>
            {%- if block.settings.name != blank -%}
              <h3 class="sk-timeline__name">{{ block.settings.name | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.role != blank -%}
              <span class="sk-timeline__role">{{ block.settings.role | escape }}</span>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="sk-timeline__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK · Timeline",
  "tag": "section",
  "class": "sk-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three generations" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Entry",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge", "info": "One or two characters, or a year.", "default": "1" },
        { "type": "text", "id": "name", "label": "Name", "default": "Name" },
        { "type": "text", "id": "role", "label": "Role", "default": "Founder" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Their part of the story.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK · Timeline",
      "blocks": [{ "type": "entry" }, { "type": "entry" }, { "type": "entry" }]
    }
  ]
}
{% endschema %}
