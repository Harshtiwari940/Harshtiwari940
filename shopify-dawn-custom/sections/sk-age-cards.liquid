{%- comment -%}
  Simply Kids — shop by age

  From v19-home. Each card can point at a collection, and the button label
  falls back to the collection title so it stays correct if the collection is
  renamed.
{%- endcomment -%}

{% render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
%}

<div class="sk-section color-{{ section.settings.color_scheme }} gradient sk-section-{{ section.id }}">
  <div class="sk-section__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="sk-section__head sk-section__head--center">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sk-section__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sk-grid sk-grid--3">
      {%- for block in section.blocks -%}
        {%- liquid
          assign age_collection = collections[block.settings.collection]
          assign link = block.settings.link
          if link == blank and age_collection != blank
            assign link = age_collection.url
          endif
          assign cta = block.settings.button_label
          if cta == blank and age_collection != blank
            assign cta = age_collection.title
          endif
        -%}

        <div class="sk-age-card" {{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}
            <span class="sk-age-card__label">{{ block.settings.label | escape }}</span>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="sk-age-card__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="sk-age-card__desc">{{ block.settings.text }}</div>
          {%- endif -%}

          {%- if link != blank and cta != blank -%}
            <a class="sk-btn sk-btn--primary" href="{{ link }}">{{ cta | escape }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SK · Age cards",
  "tag": "section",
  "class": "sk-section-wrapper",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by age" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range", "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top", "default": 56
    },
    {
      "type": "range", "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom", "default": 56
    }
  ],
  "blocks": [
    {
      "type": "age",
      "name": "Age group",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Ages 4-6" },
        { "type": "text", "id": "title", "label": "Title", "default": "The first routine" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Two gentle steps that fit into bath time.</p>"
        },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link", "info": "Overrides the collection link." },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Defaults to the collection title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK · Age cards",
      "blocks": [{ "type": "age" }, { "type": "age" }, { "type": "age" }]
    }
  ]
}
{% endschema %}
