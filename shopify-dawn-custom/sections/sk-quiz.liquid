{%- comment -%}
  Simply Kids — age / routine quiz banner

  From v19-home and v19-routine, where the options and their answers were
  hardcoded and the click handling was an inline script.

  Each option is a block carrying its own answer text and destination link, so
  marketing can add an age band or repoint a result without a developer.
{%- endcomment -%}

<script src="{{ 'sk-interactions.js' | asset_url }}" defer="defer"></script>

{% render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
%}

<div class="sk-section color-{{ section.settings.color_scheme }} gradient sk-section-{{ section.id }}">
  <div class="sk-section__inner">
    <sk-quiz class="sk-quiz" style="display: block;">
      {%- if section.settings.heading != blank -%}
        <h2 class="sk-quiz__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="sk-quiz__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="sk-quiz__options" role="group" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="sk-quiz__opt"
              aria-pressed="false"
              data-sk-quiz-option
              data-result-text="{{ block.settings.result_text | escape }}"
              data-result-url="{{ block.settings.result_link }}"
              data-result-label="{{ block.settings.result_label | escape }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | escape -}}
            </button>
          {%- endfor -%}
        </div>

        <div class="sk-quiz__result" data-sk-quiz-result role="status" hidden></div>
      {%- endif -%}
    </sk-quiz>
  </div>
</div>

{% schema %}
{
  "name": "SK · Quiz",
  "tag": "section",
  "class": "sk-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How old are they?" },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick an age and we'll point you at the right routine."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range", "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top", "default": 48
    },
    {
      "type": "range", "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom", "default": 48
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Option",
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "4-6" },
        {
          "type": "text",
          "id": "result_text",
          "label": "Answer",
          "default": "Start gentle: a mild cleanser and a light moisturiser."
        },
        { "type": "url", "id": "result_link", "label": "Answer link" },
        { "type": "text", "id": "result_label", "label": "Answer link label", "default": "See the routine" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK · Quiz",
      "blocks": [
        { "type": "option", "settings": { "label": "4-6" } },
        { "type": "option", "settings": { "label": "7-9" } },
        { "type": "option", "settings": { "label": "10-12" } }
      ]
    }
  ]
}
{% endschema %}
