{%- comment -%}
  Simply Kids — product row

  Replaces the "New arrivals" and "Essentials" blocks that were hardcoded
  inside the 40 KB v19-home section, where they were the only two dynamic
  things on the whole page.

  Because it is a section rather than part of a monolith, you can now add as
  many product rows to the homepage as you like, reorder them, and point each
  at a different collection — all in the theme editor.

  Cards come from snippets/sk-product-card.liquid, the same one the collection
  grid uses, so quick-add behaves identically everywhere.
{%- endcomment -%}

<script src="{{ 'sk-quick-add.js' | asset_url }}" defer="defer"></script>

{% render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign product_count = section.settings.products_to_show
-%}

<div class="sk-section color-{{ section.settings.color_scheme }} gradient sk-section-{{ section.id }}">
  <div class="sk-section__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="sk-section__head{% unless section.settings.align == 'left' %} sk-section__head--center{% endunless %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="sk-section__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="sk-section__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      <sk-quick-add>
        <ul
          class="sk-grid sk-grid--{{ section.settings.columns_desktop }} list-unstyled"
          style="padding: 0; margin: 0;"
        >
          {%- for product in collection.products limit: product_count -%}
            <li>
              {% render 'sk-product-card',
                product: product,
                lazy: true,
                coins_percent: section.settings.coins_percent,
                show_rating: section.settings.show_rating,
                sizes: '(min-width: 990px) 22vw, (min-width: 750px) 33vw, 50vw'
              %}
            </li>
          {%- endfor -%}
        </ul>
      </sk-quick-add>

      {%- if section.settings.show_view_all and collection.products_count > product_count -%}
        <div class="sk-section__head--center" style="margin-top: 3.2rem;">
          <a class="sk-btn sk-btn--outline" href="{{ collection.url }}">
            {{ 'sections.featured_collection.view_all' | t }}
          </a>
        </div>
      {%- endif -%}

    {%- elsif request.design_mode -%}
      {%- comment -%}
        Only shown in the theme editor, so a half-configured section is obvious
        while building without ever reaching a customer.
      {%- endcomment -%}
      <p class="sk-section__sub sk-section__head--center">
        Pick a collection for this section in the sidebar.
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SK · Product row",
  "tag": "section",
  "class": "sk-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" when there are more products",
      "default": true
    },
    { "type": "header", "content": "Card" },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "info": "Renders the Judge.me preview badge. Requires the Judge.me app embed.",
      "default": false
    },
    {
      "type": "range",
      "id": "coins_percent",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Cashback percentage",
      "info": "Set to 0 to hide.",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "SK · Product row"
    }
  ]
}
{% endschema %}
