{%- comment -%}
  Simply Kids — card grid

  The most reused layout on the site. In the previous build the same markup was
  written out by hand in v19-story (16 cards), v19-journal (6), v19-contact (2),
  v19-community (2) and v19-affiliate (3) — every one of them duplicated again
  in the matching snippet.

  Used by: page.about-us.json, page.journal.json, page.contact.json,
  page.our-community-2.json, page.affiliate.json, and the homepage.
{%- endcomment -%}

{% render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
%}

<div class="sk-section color-{{ section.settings.color_scheme }} gradient sk-section-{{ section.id }}">
  <div class="sk-section__inner">
    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.subheading != blank
    -%}
      <div class="sk-section__head{% unless section.settings.align == 'left' %} sk-section__head--center{% endunless %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="sk-section__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="sk-section__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sk-grid sk-grid--{{ section.settings.columns }}">
        {%- for block in section.blocks -%}
          <div class="sk-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 160
                | image_tag: class: 'sk-card__icon', loading: 'lazy', alt: block.settings.title
              }}
            {%- elsif block.settings.icon != 'none' -%}
              <span class="sk-card__icon" aria-hidden="true">
                {{ block.settings.icon | append: '.svg' | inline_asset_content }}
              </span>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="sk-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="sk-card__text">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="sk-card__link" href="{{ block.settings.link }}">
                {{- block.settings.link_label | escape }} &rarr;
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="sk-section__head--center" style="margin-top: 3.2rem;">
        <a
          class="sk-btn sk-btn--{{ section.settings.button_style }}"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            href="#"
            aria-disabled="true"
          {% endif %}
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SK · Card grid",
  "tag": "section",
  "class": "sk-section-wrapper",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label" },
    { "type": "url", "id": "button_link", "label": "Link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "outline", "label": "Outline" },
        { "value": "hero", "label": "Hero" }
      ],
      "default": "primary"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "icon-heart", "label": "Heart" },
            { "value": "icon-leaf", "label": "Leaf" },
            { "value": "icon-star", "label": "Star" },
            { "value": "icon-truck", "label": "Truck" },
            { "value": "icon-chat-bubble", "label": "Chat" },
            { "value": "icon-question-mark", "label": "Question" },
            { "value": "icon-lock", "label": "Lock" },
            { "value": "icon-checkmark", "label": "Checkmark" },
            { "value": "icon-discount", "label": "Discount" },
            { "value": "icon-share", "label": "Share" },
            { "value": "icon-price-tag", "label": "Price tag" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the icon above."
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Tell customers what makes this worth their attention.</p>"
        },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK · Card grid",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
