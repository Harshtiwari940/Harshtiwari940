{%- comment -%}
  Simply Kids — trust badges + payment row

  Replaces the block that was copy-pasted into all 12 page snippets AND all 12
  page sections — 24 identical copies. Changing "Free shipping over Rs 999"
  used to mean 24 edits; it is now one setting.

  Add it once to the footer group so it appears on every page, or drop it into
  individual templates where you want it.

  Icons: pick from Dawn's own icon set so they inherit currentColor and cost
  no extra request. `inline_asset_content` reads them straight from assets/.
{%- endcomment -%}

{% render 'sk-section-padding',
  id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
%}

<div class="sk-section color-{{ section.settings.color_scheme }} gradient sk-section-{{ section.id }}">
  <div class="sk-section__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="sk-trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <div class="sk-trust__item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 120
                  | image_tag: class: 'sk-trust__icon', loading: 'lazy', alt: block.settings.title
                }}
              {%- else -%}
                <span class="sk-trust__icon" aria-hidden="true">
                  {{ block.settings.icon | append: '.svg' | inline_asset_content }}
                </span>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <strong class="sk-trust__title">{{ block.settings.title | escape }}</strong>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <span class="sk-trust__text">{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_payments -%}
      <div class="sk-section__head--center" style="margin-top: 3.2rem;">
        {%- if section.settings.payment_heading != blank -%}
          <span class="sk-eyebrow">{{ section.settings.payment_heading | escape }}</span>
        {%- endif -%}

        <div class="sk-pay">
          {%- assign methods = section.settings.payment_methods | split: ',' -%}
          {%- for method in methods -%}
            {%- assign label = method | strip -%}
            {%- if label != blank -%}
              <span class="sk-pay__badge">{{ label | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SK · Trust badges",
  "tag": "section",
  "class": "sk-section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Payment methods"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Show payment row",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_heading",
      "label": "Payment row heading",
      "default": "100% payment protection, easy return policy"
    },
    {
      "type": "text",
      "id": "payment_methods",
      "label": "Payment methods",
      "info": "Comma separated. Shown as text badges.",
      "default": "UPI, VISA, Mastercard, RuPay"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "icon-truck", "label": "Truck" },
            { "value": "icon-return", "label": "Return" },
            { "value": "icon-lock", "label": "Lock" },
            { "value": "icon-heart", "label": "Heart" },
            { "value": "icon-star", "label": "Star" },
            { "value": "icon-checkmark", "label": "Checkmark" }
          ],
          "default": "icon-truck"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon",
          "info": "Overrides the icon above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "On orders over Rs 999"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK · Trust badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "icon-truck",
            "title": "Free shipping",
            "text": "On orders over Rs 999"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "icon-lock",
            "title": "COD available",
            "text": "Pay when it arrives"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "icon-return",
            "title": "No questions asked",
            "text": "Returns & exchange"
          }
        }
      ]
    }
  ]
}
{% endschema %}
