<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- assign favicon_source = settings.favicon | default: settings.logo -%}
    {%- if favicon_source != blank -%}
      <link rel="icon" type="image/png" href="{{ favicon_source | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {{ content_for_header }}
    {{ 'affiliate.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --sk-blue-deep: {{ settings.color_blue_deep }};
        --sk-blue-deep-hover: {{ settings.color_blue_deep_hover }};
        --sk-blue-wash: {{ settings.color_blue_wash }};
        --sk-blue-pale: {{ settings.color_blue_pale }};
        --sk-ink: {{ settings.color_ink }};
        --sk-cta: {{ settings.color_blue_deep }};
        --sk-cta-hover: {{ settings.color_blue_deep_hover }};
      }
      .sk-field { width: 100%; border: 1.5px solid rgba(18,59,74,.18); border-radius: 8px; padding: 1rem; font-family: var(--font-copy); }
      .sk-label { font-family: var(--font-label); font-weight: 700; font-size: 1.2rem; display: block; margin: 1.2rem 0 .4rem; }
      .sk-form-status--error { color: #B3261E; font-size: 1.3rem; }
    </style>
  </head>
  <body class="template-password">
    {{ content_for_layout }}
  </body>
</html>
